<Project>

  <!-- ЕДИНЫЙ ИСТОЧНИК ВЕРСИИ.
       Отсюда её читает хук .githooks/pre-push и создаёт подписанный тег vX.Y.Z
       при пуше в master. Менять версию — только здесь. -->
  <PropertyGroup>
    <!-- ПРАВИЛО ВЕРСИОННОСТИ (решение оператора, И-26).

         X.Y.Z-alpha.N, и две части меняются по разным поводам:

         * Z — работа. Поднимается, когда в ветку легла порция правок: новая
           возможность, исправленные замечания, починенные баги. Это внутренний
           счётчик сделанного, он растёт между выпусками.
         * alpha.N — ВЫПУСК. Поднимается только когда сборка уходит на GitHub
           и попадает человеку в руки. Пока она не ушла, N не трогается: два
           разных набора кода под одним номером — то, чего продукт не прощает
           сам себе (урок alpha.2, см. docs/RELEASES.md).
         * alpha -> beta — когда продукт перестаёт быть черновиком. Решает
           оператор, а не счётчик.

         Пример хода: 0.2.0-alpha.3 (выпущена) -> правки -> 0.2.1-alpha.3
         -> выпуск -> 0.2.1-alpha.4 либо 0.3.0-beta.1.

         Номер живёт в одном месте — здесь. Отсюда его читает хук
         .githooks/pre-push и создаёт подписанный тег vX.Y.Z при пуше в master,
         отсюда же он попадает в имя переносимого архива и в окно «О продукте».

         0.3.0-beta.1 — предложенный номер первого публичного выпуска (запуск
         eterix.pro, T-0013). Бета — только если боевые тесты И-20 пройдены
         (docs/FIELD-TESTS.md); иначе выпуск идёт как 0.2.3-alpha.4. Решает оператор. -->
    <Version>0.3.0-beta.1</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- .NET 10 (LTS, поддержка до ноября 2028). На .NET 8 стартовать нельзя:
         его LTS-поддержка заканчивается в ноябре 2026. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Воспроизводимая сборка — условие бесплатной подписи SignPath Foundation.
       ContinuousIntegrationBuild включается только в CI, иначе ломаются
       относительные пути при локальной отладке. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- КТО ВЫПУСКАЕТ. Отсюда подпись попадает в три места сразу: в свойства файла,
       в автора пакета установщика и в правый нижний угол окна — ProductInfo.Vendor
       читает AssemblyCompany. Писать её в трёх местах по отдельности значило бы
       завести три копии, которые однажды разойдутся: ровно так уже разъезжались
       единицы измерения и словари вердиктов.

       Авторские права оставлены на участников проекта: лицензия MIT и файл LICENSE
       говорят то же самое, и менять правовую строку заодно с подписью нельзя. -->
  <PropertyGroup>
    <Product>Storm Machine</Product>
    <Company>Eterix Tech - by voidnery</Company>
    <Authors>Eterix Tech - by voidnery</Authors>
    <Copyright>Copyright (c) 2026 Storm Machine contributors</Copyright>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Спайки — исследовательский код, к нему требования мягче -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('spikes'))">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>none</AnalysisLevel>
  </PropertyGroup>

</Project>

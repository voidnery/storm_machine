<Project Sdk="Microsoft.NET.Sdk">

  <!-- Портативный агент. Ссылается только на протокол: он должен собираться
       в маленький самостоятельный бинарь и не тащить за собой продукт целиком.
       Правило проверяется тестом в tests/StormMachine.ArchTests. -->

  <PropertyGroup>
    <ApplicationIcon>..\StormMachine.App\Assets\storm.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>storm-agent</AssemblyName>
    <RootNamespace>StormMachine.Agent</RootNamespace>
    <Description>storm-agent: удалённая точка измерения Storm Machine.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Нативные библиотеки — внутрь бинаря. Сегодня агенту нечего складывать
         рядом: он ссылается только на протокол. Но tools/pack-agent.sh копирует
         на площадку РОВНО ОДИН ФАЙЛ, и в этом весь смысл портативности агента.
         Стоит появиться первой нативной зависимости — и без этой строки скрипт
         молча увезёт заказчику нерабочий бинарь. Строка стоит заранее именно
         потому, что цена её отсутствия платится не здесь и не сразу. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StormMachine.Protocol\StormMachine.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Контракты провода между клиентом и агентом. Ноль ссылок на проекты — намеренно:
       формат провода обязан пережить любую перестройку доменной модели, а агент должен
       собираться в маленький самостоятельный бинарь, не таща за собой продукт целиком.
       Правило проверяется тестом в tests/StormMachine.ArchTests. -->

  <PropertyGroup>
    <Description>Протокол Storm Machine: сообщения, кадрирование, рукопожатие, сопряжение.</Description>
  </PropertyGroup>

  <!-- Сборка и разбор объявления проверяются на байтах, а не на живой сети:
       на машине без разрешённых входящих на 5353 сетевая проверка падает не по вине
       продукта, а проверка, которая падает от чужого брандмауэра, — это проверка,
       которую перестают запускать. -->
  <ItemGroup>
    <InternalsVisibleTo Include="StormMachine.Protocol.UnitTests" />
  </ItemGroup>

</Project>

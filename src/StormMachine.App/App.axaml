<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:StormMachine.App"
             x:Class="StormMachine.App.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />

    <!-- Словарь форм: методика, оговорка, чип команды, условие, плитка, статус,
         вердикт. Волна 2 дизайн-плана. -->
    <StyleInclude Source="avares://StormMachine/Controls/Forms.axaml" />

    <!-- Типографическая шкала (докс/UI-DESIGN-PLAN.md): пять ступеней плюс плитка
         и моно. Ступени задаются классами, а не числами по месту, — сторож
         в ArchTests запрещает размеры вне шкалы. -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.stat">
      <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- DynamicResource: стили загружаются раньше словаря ресурсов приложения,
         и StaticResource здесь не нашёл бы кисть. -->
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
      <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
    </Style>

    <!-- Мишени нажатия: не мельче 32×28 (docs/UI-DESIGN-PLAN.md). Продукт работает
         на ноутбуке в шкафу с оборудованием, где мышь лежит на коленке, и промах
         по «отменить» рядом с «удалить» стоит дороже восьми сэкономленных пикселей.
         Селектор берёт только сам Button, не наследников: у полосы прокрутки
         и счётчика внутри шаблонов свои кнопки, и им эта норма ни к чему. -->
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="MinWidth" Value="32" />
    </Style>

    <!-- Формы поверхностей -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.inset">
      <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Background" Value="{DynamicResource TileBrush}" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="6,1" />
    </Style>
  </Application.Styles>

  <!-- Палитра продукта — в отдельном файле и общая с окном агента: два словаря
       разошлись бы на первой же правке. Сторож в ArchTests разрешает литеральные
       цвета только там. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://StormMachine/Controls/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StormMachine.App.ViewModels"
        x:Class="StormMachine.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1180" Height="760"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <!-- Оформление намеренно нейтральное: визуальный дизайн прорабатывается
       отдельно. Здесь фиксируется только структура и навигация. -->

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="260,*">

    <!-- Шапка -->
    <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="16,12" Background="#1F2430">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="Storm Machine" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Border Background="#2E3648" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
          <TextBlock Text="{Binding LevelText}" FontSize="12" Opacity="0.85" />
        </Border>
      </StackPanel>
    </Border>

    <!-- Боковая навигация -->
    <Border Grid.Row="1" Grid.Column="0" Background="#191D26">
      <ListBox ItemsSource="{Binding Sections}"
               SelectedItem="{Binding SelectedSection}"
               Background="Transparent"
               BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:NavigationSection">
            <StackPanel Spacing="2" Margin="0,4">
              <TextBlock Text="{Binding Title}" FontSize="14" />
              <TextBlock Text="{Binding Route}" FontSize="11" Opacity="0.45" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Содержимое раздела -->
    <ScrollViewer Grid.Row="1" Grid.Column="1" Padding="32,24">
      <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left"
                  DataContext="{Binding SelectedSection}" x:DataType="vm:NavigationSection">

        <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Description}" FontSize="15" Opacity="0.8" TextWrapping="Wrap" />

        <Border Background="#232A38" CornerRadius="6" Padding="16" Margin="0,8,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="Состояние раздела" FontWeight="SemiBold" Opacity="0.7" FontSize="12" />
            <TextBlock Text="{Binding Availability}" FontSize="15" />
            <TextBlock TextWrapping="Wrap" FontSize="13" Opacity="0.6"
                       Text="Раздел показан заранее намеренно: недоступное не прячется, а объясняется. Порядок итераций описан в docs/03-development-plan.md." />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- Строка состояния -->
    <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="16,8" Background="#1F2430">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding WindowTitle}" FontSize="12" Opacity="0.5" VerticalAlignment="Center" />
      </Grid>
    </Border>

  </Grid>
</Window>

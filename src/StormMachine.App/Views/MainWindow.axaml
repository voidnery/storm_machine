<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StormMachine.App.ViewModels"
        xmlns:services="using:StormMachine.App.Services"
        x:Class="StormMachine.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/storm.ico"
        Width="1280" Height="820"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+K" Command="{Binding Palette.ToggleCommand}" />
  </Window.KeyBindings>

  <!-- Оформление намеренно нейтральное: визуальный дизайн прорабатывается
       отдельно. Здесь фиксируется только структура и навигация. -->

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" ColumnDefinitions="240,*">

    <!-- Полоса оповещения. Живёт в оболочке, потому что алерт приходит тогда,
         когда оператор смотрит на любой другой экран, — иначе он и не нужен. -->
    <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="16,9"
            IsVisible="{Binding Notifications.IsVisible}"
            Background="#3A1E1E">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                Background="{StaticResource DangerBrush}" />
        <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" FontSize="13"
                   Text="{Binding Notifications.Text}" TextWrapping="Wrap" />
        <Button Grid.Column="2" Content="Открыть алерты" Padding="12,4" Margin="0,0,8,0"
                Command="{Binding GoToCommand}" CommandParameter="/alerts" />
        <Button Grid.Column="3" Content="Скрыть" Padding="12,4" Command="{Binding DismissAlertCommand}" />
      </Grid>
    </Border>

    <!-- Шапка -->
    <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="16,10" Background="{StaticResource ChromeBrush}">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="Storm Machine" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Border Grid.Column="1" Background="#2E3648" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding LevelText}" FontSize="12" Opacity="0.85" />
        </Border>

        <!-- Палитра вызывается и мышью: сочетание клавиш, о котором нигде не сказано,
             известно только тем, кто и без него разберётся. -->
        <Button Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,10,0"
                Command="{Binding Palette.OpenCommand}"
                Padding="12,5" Background="#2E3648" BorderThickness="0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Найти раздел или цель" FontSize="12" Opacity="0.8" />
            <TextBlock Text="Ctrl+K" FontSize="11" Opacity="0.45" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Центр уведомлений: полоса показывает одно оповещение и исчезает,
             а этот счётчик отвечает на вопрос, не пропущено ли что-то за время отсутствия. -->
        <Button Grid.Column="3" Margin="0,0,10,0"
                Command="{Binding ToggleNotificationsCommand}"
                Padding="12,5" Background="#2E3648" BorderThickness="0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{StaticResource DangerBrush}"
                     IsVisible="{Binding Notifications.HasUnread}" />
            <TextBlock Text="Уведомления" FontSize="12" />
            <TextBlock Text="{Binding Notifications.UnreadCount}" FontSize="11" Opacity="0.6"
                       VerticalAlignment="Center" IsVisible="{Binding Notifications.HasUnread}" />
          </StackPanel>
        </Button>

        <!-- Кнопка Run Drawer: выполняющиеся операции доступны с любого экрана,
             потому что тесты длинные и оператор не обязан сидеть на одном экране. -->
        <Button Grid.Column="4"
                Command="{Binding ToggleDrawerCommand}"
                Padding="12,5"
                Background="#2E3648"
                BorderThickness="0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{StaticResource AccentBrush}"
                     IsVisible="{Binding HasActiveRuns}" />
            <TextBlock Text="{Binding ActiveRunsCaption}" FontSize="12" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Боковая навигация -->
    <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource SidebarBrush}">
      <ScrollViewer>
        <ListBox ItemsSource="{Binding Sections}"
                 SelectedItem="{Binding SelectedSection}"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavigationSection">
              <StackPanel Spacing="1" Margin="0,3">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Title}" FontSize="14" />
                  <TextBlock Text="{Binding Iteration}" FontSize="10" Opacity="0.4"
                             VerticalAlignment="Center"
                             IsVisible="{Binding !IsReady}" />
                </StackPanel>
                <TextBlock Text="{Binding Route}" FontSize="10" Opacity="0.4" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>
    </Border>

    <!-- Содержимое раздела -->
    <ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding CurrentPage}" />

    <!-- Лента уведомлений -->
    <Border Grid.Row="2" Grid.Column="1" Width="380" HorizontalAlignment="Right"
            Background="#151922" BorderBrush="#2A3140" BorderThickness="1,0,0,0"
            Padding="14" ZIndex="50"
            IsVisible="{Binding IsNotificationsOpen}">
      <Grid RowDefinitions="Auto,Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="Уведомления" FontSize="13" FontWeight="SemiBold" />
          <Button Grid.Column="1" Content="Закрыть" Padding="10,3" FontSize="11"
                  Command="{Binding ToggleNotificationsCommand}" />
        </Grid>

        <TextBlock Grid.Row="1" FontSize="10" Opacity="0.45" TextWrapping="Wrap" Margin="0,6,0,10"
                   Text="Последние оповещения этого сеанса. Полная история — в разделе «Алерты»." />

        <TextBlock Grid.Row="2" Text="Пока ничего не приходило." FontSize="12" Opacity="0.5"
                   VerticalAlignment="Top" IsVisible="{Binding Notifications.IsEmpty}" />

        <ScrollViewer Grid.Row="2" IsVisible="{Binding !Notifications.IsEmpty}">
          <ItemsControl ItemsSource="{Binding Notifications.Recent}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="services:AlertNotice">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="10,8" Margin="0,3">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                            VerticalAlignment="Top" Margin="0,5,0,0"
                            Background="{StaticResource DangerBrush}"
                            IsVisible="{Binding IsAlarming}" />
                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                            VerticalAlignment="Top" Margin="0,5,0,0"
                            Background="#7DD3A0"
                            IsVisible="{Binding !IsAlarming}" />
                    <StackPanel Grid.Column="1" Spacing="2" Margin="10,0,0,0">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding When}" FontSize="10" Opacity="0.45"
                                   FontFamily="Consolas,Menlo,monospace" Margin="8,0,0,0" />
                      </Grid>
                      <TextBlock Text="{Binding Text}" FontSize="11" Opacity="0.7"
                                 TextWrapping="Wrap" LineHeight="16" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
          <Button Grid.Column="0" Content="Открыть алерты" Padding="12,5" HorizontalAlignment="Left"
                  Command="{Binding GoToCommand}" CommandParameter="/alerts" />
          <Button Grid.Column="1" Content="Очистить" Padding="12,5"
                  Command="{Binding ClearNotificationsCommand}" />
        </Grid>
      </Grid>
    </Border>

    <!-- Run Drawer -->
    <Border Grid.Row="3" Grid.ColumnSpan="2"
            Background="#151922"
            BorderBrush="#2A3140" BorderThickness="0,1,0,0"
            Padding="16,10"
            IsVisible="{Binding IsDrawerOpen}">
      <StackPanel Spacing="8">
        <TextBlock Text="Выполняющиеся операции" FontWeight="SemiBold" FontSize="13" Opacity="0.8" />

        <TextBlock Text="Сейчас ничего не выполняется."
                   FontSize="12" Opacity="0.5"
                   IsVisible="{Binding !HasActiveRuns}" />

        <ItemsControl ItemsSource="{Binding ActiveRuns}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ActiveOperationViewModel">
              <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="12,8" Margin="0,3">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                  <Border Grid.Column="0" Background="#2E3648" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Kind}" FontSize="11" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0" VerticalAlignment="Center" FontSize="13" />
                  <TextBlock Grid.Column="2" Text="{Binding Detail}"
                             FontSize="12" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <Button Grid.Column="3"
                          Content="Остановить"
                          Command="{Binding CancelCommand}"
                          IsEnabled="{Binding CanCancel}"
                          FontSize="12" Padding="10,4" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Строка состояния -->
    <Border Grid.Row="4" Grid.ColumnSpan="2" Padding="16,7" Background="{StaticResource ChromeBrush}">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding AdapterLine}" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding FloorLine}" FontSize="12" Opacity="0.5" Margin="14,0,0,0" VerticalAlignment="Center" />

        <!-- Предупреждение об окружении стоит в строке состояния намеренно:
             оператор должен увидеть его до того, как поверит цифрам. -->
        <TextBlock Grid.Column="2"
                   Text="{Binding AdapterWarning}"
                   Foreground="{StaticResource WarningBrush}"
                   FontSize="12" Margin="18,0,0,0"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"
                   IsVisible="{Binding AdapterWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <TextBlock Grid.Column="3" Text="{Binding WindowTitle}" FontSize="12" Opacity="0.4" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Палитра команд. Поверх всего и на всё окно: она перехватывает внимание
         целиком, иначе поиск превращается в ещё один элемент интерфейса, который
         надо найти глазами. -->
    <Border x:Name="PaletteOverlay"
            Grid.Row="0" Grid.RowSpan="5" Grid.ColumnSpan="2"
            Background="#CC0F1219" ZIndex="100"
            IsVisible="{Binding Palette.IsOpen}">
      <Border Width="720" MaxHeight="520" VerticalAlignment="Top" Margin="0,90,0,0"
              Background="{StaticResource PanelBrush}" CornerRadius="8"
              BorderBrush="#3A4356" BorderThickness="1" Padding="14">
        <Grid RowDefinitions="Auto,Auto,*" DataContext="{Binding Palette}">

          <TextBox x:Name="PaletteBox" Grid.Row="0" FontSize="15" Padding="10,8"
                   PlaceholderText="раздел или адрес узла"
                   Text="{Binding Query}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
              <KeyBinding Gesture="Enter" Command="{Binding RunCommand}" />
              <KeyBinding Gesture="Down" Command="{Binding MoveDownCommand}" />
              <KeyBinding Gesture="Up" Command="{Binding MoveUpCommand}" />
            </TextBox.KeyBindings>
          </TextBox>

          <TextBlock Grid.Row="1" Text="{x:Static vm:CommandPaletteViewModel.Hint}"
                     FontSize="10" Opacity="0.45" Margin="2,7,2,9" TextWrapping="Wrap" />

          <TextBlock Grid.Row="2" Text="Ничего не нашлось." FontSize="12" Opacity="0.5"
                     Margin="2,4" IsVisible="{Binding IsEmpty}" />

          <ListBox Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                   Background="Transparent" BorderThickness="0"
                   IsVisible="{Binding !IsEmpty}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PaletteItem">
                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                  <StackPanel Grid.Column="0" Spacing="1">
                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="10" Opacity="0.5"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Group}" FontSize="10" Opacity="0.4"
                             VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Border>

  </Grid>
</Window>

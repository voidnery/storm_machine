<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StormMachine.App.ViewModels"
             x:Class="StormMachine.App.Views.Pages.PlaceholderPage"
             x:DataType="vm:PlaceholderPageViewModel">

  <ScrollViewer Padding="32,24">
    <StackPanel Spacing="14" MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Description}" FontSize="15" Opacity="0.8" TextWrapping="Wrap" />

      <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="16" Margin="0,8,0,0">
        <StackPanel Spacing="8">
          <TextBlock Text="Состояние раздела" FontWeight="SemiBold" Opacity="0.7" FontSize="12" />
          <TextBlock Text="{Binding Availability}" FontSize="15" />
          <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="13" Opacity="0.6" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>

</UserControl>

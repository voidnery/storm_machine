<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StormMachine.App.ViewModels"
             x:Class="StormMachine.App.Views.Pages.PlaceholderPage"
             x:DataType="vm:PlaceholderPageViewModel">

  <ScrollViewer Padding="32,24">
    <StackPanel Spacing="14" MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Description}" FontSize="13" TextWrapping="Wrap" />

      <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="16" Margin="0,8,0,0">
        <StackPanel Spacing="8">
          <TextBlock Text="Состояние раздела" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
          <TextBlock Text="{Binding Availability}" FontSize="13" />
          <Border Padding="10,8" CornerRadius="4" Background="{StaticResource TileBrush}"
                  IsVisible="{Binding ConsoleCommands, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding ConsoleCommands}" FontSize="12" TextWrapping="Wrap"
                       LineHeight="18" FontFamily="Consolas,Menlo,monospace" />
          </Border>
          <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>

</UserControl>

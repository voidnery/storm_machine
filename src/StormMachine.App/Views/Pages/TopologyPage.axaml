<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StormMachine.App.ViewModels"
             xmlns:controls="using:StormMachine.App.Views.Controls"
             x:Class="StormMachine.App.Views.Pages.TopologyPage"
             x:DataType="vm:TopologyPageViewModel">

  <Grid RowDefinitions="Auto,Auto,*" Margin="24,20">

    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />

      <!-- Оговорки заметнее сводки: они говорят не о достоверности связей,
           а о том, что карту нельзя читать буквально. -->
      <TextBlock Text="{Binding Caveats}" FontSize="12" TextWrapping="Wrap"
                 Foreground="{StaticResource WarningBrush}"
                 IsVisible="{Binding Caveats, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <Border Grid.Row="1" Margin="0,12,0,0" Padding="14,10" CornerRadius="6"
            Background="{StaticResource PanelBrush}">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
          <CheckBox Grid.Column="0" IsChecked="{Binding IncludeExternalPaths}" FontSize="12"
                    Content="Внешние пути" Margin="0,0,14,0"
                    ToolTip.Tip="Узлы из сохранённых трассировок" />
          <CheckBox Grid.Column="1" IsChecked="{Binding IncludeVirtualAdapters}" FontSize="12"
                    Content="Виртуальные сети" Margin="0,0,14,0"
                    ToolTip.Tip="Коммутаторы Hyper-V, Docker и VPN" />
          <CheckBox Grid.Column="2" IsChecked="{Binding ExpandAll}" FontSize="12"
                    Content="Все устройства" Margin="0,0,14,0"
                    ToolTip.Tip="Не сворачивать конечные узлы в счётчик" />

          <!-- Опрос по SNMP выключен по умолчанию: он идёт по чужой сети и занимает
               секунды на устройство. Слать трафик к оборудованию заказчика при каждом
               взгляде на карту продукт не станет. -->
          <CheckBox Grid.Column="3" IsChecked="{Binding UseSnmp}" FontSize="12"
                    Content="Опросить SNMP" Margin="0,0,14,0"
                    ToolTip.Tip="Порты коммутаторов и соседей по LLDP. Требует заведённых учётных данных" />

          <Button Grid.Column="4" Content="Развернуть выбранное" Command="{Binding ExpandCommand}"
                  FontSize="12" Padding="10,4" Margin="0,0,10,0" />

          <TextBlock Grid.Column="5" Text="{Binding StatusLine}" FontSize="12" Opacity="0.65"
                     VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" />

          <Button Grid.Column="6" Content="PNG" Command="{Binding ExportPngCommand}"
                  FontSize="12" Padding="12,4" Margin="0,0,6,0" />
          <Button Grid.Column="7" Content="SVG" Command="{Binding ExportSvgCommand}"
                  FontSize="12" Padding="12,4" Margin="0,0,6,0" />
          <Button Grid.Column="8" Content="JSON" Command="{Binding ExportJsonCommand}"
                  FontSize="12" Padding="12,4" />
        </Grid>

        <!-- Опрос идёт секундами на устройство: молчащий в это время инструмент
             выглядит зависшим. -->
        <TextBlock Text="{Binding Note}" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                   IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,320" Margin="0,14,0,0">

      <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True">
        <Grid RowDefinitions="*,Auto">
          <controls:TopologyCanvas Grid.Row="0" Name="Canvas"
                                   Graph="{Binding Graph}"
                                   Layout="{Binding Layout}"
                                   SelectedNode="{Binding SelectedNode, Mode=TwoWay}" />

          <!-- Легенда лежит прямо на карте: различие достоверности — главное,
               что карта сообщает, и объяснять его надо там же, где смотрят. -->
          <Border Grid.Row="1" Background="#1A1F2B" Padding="12,7">
            <StackPanel Orientation="Horizontal" Spacing="18">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Rectangle Width="24" Height="2" Fill="#4B7FD1" VerticalAlignment="Center" />
                <TextBlock Text="подтверждено" FontSize="11" Opacity="0.7" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Rectangle Width="24" Height="2" Fill="#7A8AA5" VerticalAlignment="Center"
                           StrokeDashArray="2,1.5" />
                <TextBlock Text="выведено по правилу" FontSize="11" Opacity="0.7" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Rectangle Width="24" Height="2" Fill="#5D6B82" VerticalAlignment="Center"
                           StrokeDashArray="0.6,2" />
                <TextBlock Text="допущение" FontSize="11" Opacity="0.7" />
              </StackPanel>
              <TextBlock Text="цвет рамки — категория устройства" FontSize="11" Opacity="0.7"
                         VerticalAlignment="Center" />
              <TextBlock Text="Колесо — масштаб, перетаскивание — сдвиг, щелчок — выбор узла."
                         FontSize="11" Opacity="0.45" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1" Margin="14,0,0,0" CornerRadius="6"
              Background="{StaticResource PanelBrush}" Padding="12">
        <Grid RowDefinitions="Auto,Auto,*,Auto" MinWidth="300">
          <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,8">
            <TextBlock Text="Выбранный узел" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="Щёлкните узел на карте — покажу его связи и то, откуда они взялись."
                       FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Row="1" Spacing="2" Margin="0,0,0,10"
                      IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding SelectedNode.Label}" FontSize="14" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedNode.Address}" FontSize="12" Opacity="0.7"
                       IsVisible="{Binding SelectedNode.Address, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{Binding SelectedNode.MacAddress}" FontSize="12" Opacity="0.7"
                       IsVisible="{Binding SelectedNode.MacAddress, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{Binding SelectedNode.Vendor}" FontSize="12" Opacity="0.7"
                       TextWrapping="Wrap"
                       IsVisible="{Binding SelectedNode.Vendor, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{Binding SelectedNode.Role}" FontSize="12"
                       Foreground="{StaticResource AccentBrush}"
                       IsVisible="{Binding SelectedNode.Role, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{Binding SelectedNode.Detail}" FontSize="11" Opacity="0.55"
                       TextWrapping="Wrap"
                       IsVisible="{Binding SelectedNode.Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>

          <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding SelectedLinks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LinkRow">
                  <Border Padding="8,6" Margin="0,0,0,6" CornerRadius="4" Background="#1A2130">
                    <StackPanel Spacing="3">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Peer}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Confidence}" FontSize="10"
                                   Opacity="0.75" Margin="8,0,0,0" />
                      </Grid>
                      <!-- Догадка обязана себя объяснять: иначе её нельзя
                           ни проверить, ни оспорить. -->
                      <TextBlock Text="{Binding Because}" FontSize="10.5" Opacity="0.55"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding !IsConfirmed}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel Grid.Row="3" Spacing="8" Margin="0,8,0,0">
            <!-- Правка карты. Связь рисуется в два приёма: сначала запоминается один
                 узел, потом выбирается второй. Перетаскивание было бы естественнее,
                 но случайное движение мышью создавало бы связи, которых никто
                 не рисовал. -->
            <Border Background="#1A2130" CornerRadius="4" Padding="10,8">
              <StackPanel Spacing="6">
                <TextBlock Text="Поправить карту" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Text="{Binding PinnedCaption}" FontSize="11" Opacity="0.6"
                           TextTrimming="CharacterEllipsis" />

                <TextBox Text="{Binding LinkNote}" FontSize="11"
                         PlaceholderText="откуда известно — попадёт в подпись связи" />

                <WrapPanel>
                  <Button Content="Запомнить" Command="{Binding PinCommand}"
                          FontSize="11" Padding="9,4" Margin="0,0,6,6"
                          ToolTip.Tip="Запомнить выбранный узел как первый конец связи" />
                  <Button Content="Соединить" Command="{Binding LinkCommand}"
                          FontSize="11" Padding="9,4" Margin="0,0,6,6" />
                  <Button Content="Разъединить" Command="{Binding UnlinkCommand}"
                          FontSize="11" Padding="9,4" Margin="0,0,6,6"
                          ToolTip.Tip="Убрать связь, которую инструмент вывел ошибочно" />
                  <Button Content="Скрыть" Command="{Binding HideCommand}"
                          FontSize="11" Padding="9,4" Margin="0,0,6,6"
                          ToolTip.Tip="Убрать узел с карты. В инвентаре он остаётся" />
                  <Button Content="Это одно устройство" Command="{Binding MergeCommand}"
                          FontSize="11" Padding="9,4" Margin="0,0,6,6"
                          ToolTip.Tip="Объединить запомненный узел и выбранный — например, провод и Wi-Fi одного ноутбука" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- Правки видны списком и отменяются поштучно: догадка инструмента
                 объясняет себя, и правка человека тоже должна. -->
            <StackPanel Spacing="4" IsVisible="{Binding Edits.Count}">
              <TextBlock Text="Правки оператора" FontWeight="SemiBold" FontSize="12" />

              <ItemsControl ItemsSource="{Binding Edits}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EditRow">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                      <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Text="{Binding Text}" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Note}" FontSize="10" Opacity="0.5" TextWrapping="Wrap"
                                   IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Text="{Binding When}" FontSize="10" Opacity="0.4" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="отменить" FontSize="10" Padding="7,3"
                              VerticalAlignment="Top"
                              Command="{Binding $parent[ItemsControl].((vm:TopologyPageViewModel)DataContext).ForgetCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Обновить" Command="{Binding RefreshCommand}" FontSize="12" Padding="10,4" />
              <Button Content="Свернуть всё" Command="{Binding CollapseAllCommand}" FontSize="12" Padding="10,4" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

  </Grid>
</UserControl>

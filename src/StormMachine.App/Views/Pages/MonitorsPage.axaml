<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StormMachine.App.ViewModels"
             xmlns:forms="using:StormMachine.App.Controls"
             xmlns:scenarios="using:StormMachine.Domain.Scenarios"
             x:Class="StormMachine.App.Views.Pages.MonitorsPage"
             x:DataType="vm:MonitorsPageViewModel">

  <Grid RowDefinitions="Auto,*" Margin="24,20">

    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
        <Button Grid.Column="1" Content="Завести" Command="{Binding ToggleEditorCommand}"
                Padding="14,5" Margin="0,0,8,0"
                Background="{StaticResource AccentBrush}" Foreground="White" />
        <Button Grid.Column="2" Content="Проверить сейчас" Command="{Binding RunNowCommand}" Padding="12,5" Margin="0,0,8,0" IsEnabled="{Binding HasSelection}" />
        <Button Grid.Column="3" Content="Вкл / выкл" Command="{Binding ToggleCommand}" Padding="12,5" Margin="0,0,8,0" IsEnabled="{Binding HasSelection}" />
        <Button Grid.Column="4" Content="Обновить" Command="{Binding RefreshCommand}" Padding="12,5" Margin="0,0,8,0" />
        <Button Grid.Column="5" Content="Удалить" Command="{Binding DeleteCommand}" Padding="12,5" IsEnabled="{Binding HasSelection}" />
      </Grid>

      <TextBlock Text="{Binding SchedulerState}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />

      <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="380,*">

      <!-- Список мониторов -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="8">
        <Panel>
        <TextBlock Text="Мониторов ещё нет. «Завести» — и проверка пойдёт по расписанию сама."
                   Classes="label" TextWrapping="Wrap" Margin="8,10"
                   VerticalAlignment="Top" IsVisible="{Binding !Monitors.Count}" />
        <ListBox ItemsSource="{Binding Monitors}"
                 SelectedItem="{Binding Selected}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MonitorRow">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">

                <!-- Цвет состояния — не украшение: это первое, что читают в списке -->
                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                        Background="{Binding Level, Converter={x:Static vm:VerdictBrushConverter.Instance}}" />

                <StackPanel Grid.Column="1" Spacing="1" Margin="10,0">
                  <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subject}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Schedule}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="1" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding StateText}" FontSize="11" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding NextText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                  <TextBlock Text="алерт поднят" FontSize="10" HorizontalAlignment="Right"
                             Foreground="{StaticResource DangerBrush}"
                             IsVisible="{Binding IsAlerting}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Panel>
      </Border>

      <!-- Форма заведения. Занимает место подробностей, но не список: выбранный
           монитор остаётся на виду, и с него можно списать настройки. -->
      <Border Grid.Column="1" Margin="14,0,0,0" Background="{StaticResource PanelBrush}" CornerRadius="6"
              Padding="16" IsVisible="{Binding IsEditorOpen}">
        <Grid RowDefinitions="*,Auto">

          <ScrollViewer Grid.Row="0" DataContext="{Binding Editor}">
            <StackPanel x:DataType="vm:MonitorEditorViewModel" Spacing="12" Margin="0,0,10,0">

              <TextBlock Text="Новый монитор" FontSize="13" FontWeight="SemiBold" />

              <StackPanel Spacing="3">
                <TextBlock Text="Имя" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox PlaceholderText="шлюз, сайт заказчика" Text="{Binding Name}" />
              </StackPanel>

              <StackPanel Spacing="3">
                <TextBlock Text="Что проверять" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                <forms:Picker ItemsSource="{Binding Subjects}" SelectedItem="{Binding Subject, Mode=TwoWay}" />
                <TextBlock Text="{Binding TargetHint}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="3">
                <TextBlock Text="Цель" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox PlaceholderText="адрес, имя узла или URL" Text="{Binding Target}" />
              </StackPanel>

              <StackPanel Spacing="3">
                <TextBlock Text="Как часто" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                <forms:Picker ItemsSource="{Binding Schedules}" SelectedItem="{Binding Schedule, Mode=TwoWay}" />

                <!-- Cron вводится текстом: строка «0 3 * * 1-5» короче и точнее
                     любого набора выпадающих списков -->
                <TextBox PlaceholderText="0 3 * * *" Text="{Binding Cron}"
                         IsVisible="{Binding NeedsCronText}" Margin="0,3,0,0" />
                <TextBlock Text="{x:Static vm:MonitorEditorViewModel.CronHint}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap" IsVisible="{Binding NeedsCronText}" />
              </StackPanel>

              <CheckBox Content="После простоя выполнить один раз" IsChecked="{Binding CatchUp}" />

              <StackPanel Spacing="6">
                <TextBlock Text="Пороги — при нарушении монитор считает проверку отказом"
                           Classes="label" TextWrapping="Wrap" />

                <forms:MethodCard Thesis="{x:Static vm:MonitorEditorViewModel.ThresholdNote}"
                                  Detail="{x:Static vm:MonitorEditorViewModel.ThresholdNoteWhy}" />

                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" PlaceholderText="p95 &lt; 50" Text="{Binding ThresholdText}" />
                  <Button Grid.Column="1" Content="Добавить" Command="{Binding AddThresholdCommand}"
                          Padding="12,5" Margin="6,0,0,0" />
                </Grid>

                <!-- Набранное коротко, прочитанное словами: без второй половины
                     поле не отвечало ни что такое p95, ни в чём эти 50. -->
                <ItemsControl ItemsSource="{Binding Thresholds}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ThresholdRow">
                      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding Text}" Classes="body mono"
                                   VerticalAlignment="Center" Width="130" />
                        <TextBlock Grid.Column="1" Text="{Binding Explanation}" Classes="label"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Content="убрать" Padding="8,2" FontSize="10"
                                Command="{Binding $parent[ItemsControl].((vm:MonitorEditorViewModel)DataContext).RemoveThresholdCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Список метрик прямо в форме: помнить наизусть незачем -->
                <Expander Header="Какие бывают метрики" FontSize="11">
                  <ItemsControl ItemsSource="{x:Static vm:MonitorEditorViewModel.Metrics}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="scenarios:MetricHelp">
                        <Grid ColumnDefinitions="90,70,*" Margin="0,2">
                          <TextBlock Grid.Column="0" Text="{Binding Key}" Classes="body mono" />
                          <TextBlock Grid.Column="1" Text="{Binding Unit}" Classes="caption"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding About}" Classes="caption"
                                     TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>

                <forms:Caveat Text="Без порогов монитор копит историю, но ни о чём не судит." />
              </StackPanel>

              <CheckBox Content="Оповещать" IsChecked="{Binding Alert}" />

              <StackPanel Spacing="6" IsVisible="{Binding Alert}" Margin="18,0,0,0">

                <!-- Каналы доставки: без единой отметки монитор молчит, как бы
                     ни был настроен гистерезис. -->
                <StackPanel Spacing="3">
                  <TextBlock Text="Куда оповещать" Classes="caption" />
                  <ItemsControl ItemsSource="{Binding Channels}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ChannelChoice">
                        <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChosen}" FontSize="11" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <forms:Caveat Text="{Binding ChannelWarning}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,10,*">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Поднять алерт после, проверок" Classes="caption" ToolTip.Tip="Столько неудачных проверок подряд нужно, чтобы поднять алерт" />
                    <NumericUpDown Value="{Binding RaiseAfter}" Minimum="1" Maximum="20" Increment="1"
                                   FormatString="0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="Снять алерт после, проверок" Classes="caption" ToolTip.Tip="Столько удачных проверок подряд нужно, чтобы снять алерт" />
                    <NumericUpDown Value="{Binding ClearAfter}" Minimum="1" Maximum="20" Increment="1"
                                   FormatString="0" />
                  </StackPanel>
                </Grid>

                <StackPanel Spacing="3">
                  <TextBlock Text="Пауза между оповещениями" Classes="caption" />
                  <TextBox PlaceholderText="15м" Text="{Binding Cooldown}" />
                  <TextBlock Text="{x:Static vm:MonitorEditorViewModel.DurationHint}"
                             Classes="caption" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Text="{x:Static vm:MonitorEditorViewModel.HysteresisHint}"
                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="15" />
              </StackPanel>

              <StackPanel Spacing="3">
                <TextBlock Text="Окно обслуживания" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox PlaceholderText="пн-пт 02:00-04:00 регламент" Text="{Binding Maintenance}" />
                <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="Проверки в это окно не идут, а время не считается ни простоем, ни работой." />
              </StackPanel>

              <StackPanel Spacing="3">
                <TextBlock Text="Цель по доступности за месяц, %" Classes="label" ToolTip.Tip="Уровень услуги (SLA): какую долю времени монитор обязан видеть цель исправной" />
                <NumericUpDown Value="{Binding ObjectivePercent}" Minimum="50" Maximum="100"
                               Increment="0.1" FormatString="0.###" />
                <TextBlock Text="{Binding ObjectiveHint}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
              </StackPanel>

              <!-- Что получится, сказанное словами: форма объясняет свой смысл
                   до нажатия кнопки, а не после -->
              <Border Padding="12,10" CornerRadius="4" Background="{StaticResource TileBrush}">
                <StackPanel Spacing="4">
                  <TextBlock Text="Получится" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding Preview}" FontSize="11" TextWrapping="Wrap" LineHeight="17" />
                </StackPanel>
              </Border>

              <TextBlock Text="{Binding Error}" FontSize="11" TextWrapping="Wrap"
                         Foreground="{StaticResource DangerBrush}"
                         IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

            </StackPanel>
          </ScrollViewer>

          <!-- Кнопки живут вне области формы: их команды принадлежат экрану, а не форме -->
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <Button Grid.Column="0" Content="Отмена" Command="{Binding ToggleEditorCommand}"
                    Padding="14,6" HorizontalAlignment="Left" />
            <Button Grid.Column="1" Content="Завести монитор" Command="{Binding CreateCommand}"
                    Padding="18,6" Background="{StaticResource AccentBrush}" Foreground="White" />
          </Grid>
        </Grid>
      </Border>

      <!-- Подробности -->
      <Border Grid.Column="1" Margin="14,0,0,0" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="16"
              IsVisible="{Binding !IsEditorOpen}">
        <ScrollViewer>
          <StackPanel Spacing="14">

            <TextBlock Text="{Binding Details}" FontSize="13" TextWrapping="Wrap" LineHeight="20" />

            <Border Padding="12,10" CornerRadius="4" Background="{StaticResource TileBrush}"
                    IsVisible="{Binding AvailabilityText, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Spacing="6">
                <TextBlock Text="Доступность" Classes="h2" />
                <TextBlock Text="{Binding AvailabilityText}" Classes="body" TextWrapping="Wrap" LineHeight="19" />

                <forms:MethodCard Thesis="Бюджет ошибок — сколько простоя допускает цель по доступности."
                                  Detail="При цели 99.9 % за месяц это 43 минуты. Израсходованный бюджет говорит, сколько из них уже потрачено: число само по себе не показывает, близко ли нарушение." />

                <!-- Оговорка о покрытии не прячется: 100 % при покрытии 4 % —
                     это отсутствие данных, а не отличная сеть. Она обязана звучать
                     громче самого числа, а не тише его. -->
                <forms:Caveat Text="{Binding CoverageNotice}" />
              </StackPanel>
            </Border>

            <StackPanel Spacing="6" IsVisible="{Binding HasChecks}">
              <TextBlock Text="Последние проверки" Classes="h2" />

              <!-- Заголовки колонок: три столбца без подписей приходилось разгадывать -->
              <Grid ColumnDefinitions="130,120,*">
                <TextBlock Grid.Column="0" Text="когда" Classes="caption" />
                <TextBlock Grid.Column="1" Text="итог" Classes="caption" />
                <TextBlock Grid.Column="2" Text="что измерено" Classes="caption" />
              </Grid>

              <ItemsControl ItemsSource="{Binding Checks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CheckRow">
                    <Grid ColumnDefinitions="130,120,*" Margin="0,2">
                      <TextBlock Grid.Column="0" Text="{Binding When}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                 FontFamily="Consolas,Menlo,monospace" />
                      <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="11">
                        <TextBlock.Styles>
                          <Style Selector="TextBlock">
                            <Setter Property="Opacity" Value="0.85" />
                          </Style>
                        </TextBlock.Styles>
                      </TextBlock>
                      <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="11"
                                 TextTrimming="CharacterEllipsis"
                                 Opacity="{Binding IsGap, Converter={x:Static vm:GapOpacityConverter.Instance}}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <forms:MethodCard Thesis="Форма даёт разумные умолчания; полная власть над расписанием и гистерезисом — у консоли."
                              Detail="Экран и консоль работают с одной базой и одним планировщиком: заведённое здесь видно там, и наоборот." />
            <forms:CopyChip Text="storm monitors add" />

          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StormMachine.App.ViewModels"
             xmlns:views="using:StormMachine.App.Views"
             x:Class="StormMachine.App.Views.Pages.SpeedPage"
             x:DataType="vm:SpeedPageViewModel">

  <Grid RowDefinitions="Auto,*" Margin="24,20">

    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
      <TextBlock Text="{x:Static vm:SpeedPageViewModel.Note}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                 TextWrapping="Wrap" LineHeight="16" />
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <views:ProbeRunnerView DataContext="{Binding Runner}" Margin="0,0,10,20" />
    </ScrollViewer>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StormMachine.App.ViewModels"
             xmlns:forms="using:StormMachine.App.Controls"
             x:Class="StormMachine.App.Views.Pages.AlertsPage"
             x:DataType="vm:AlertsPageViewModel">

  <Grid RowDefinitions="Auto,*" Margin="24,20">

    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
        <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}" Padding="12,5" />
      </Grid>
      <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,320">

      <!-- Лента -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="12">
        <ScrollViewer>
          <Panel>
            <TextBlock Text="Событий нет. Алерт поднимается, когда монитор нарушает свои пороги нужное число проверок подряд."
                       Classes="label" TextWrapping="Wrap" VerticalAlignment="Top"
                       IsVisible="{Binding !Alerts.Count}" />
          <ItemsControl ItemsSource="{Binding Alerts}"
                        IsVisible="{Binding Alerts.Count}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AlertRow">
                <Border Margin="0,0,0,8" Padding="12,9" CornerRadius="4" Background="{StaticResource TileBrush}">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                              Background="{StaticResource DangerBrush}"
                              IsVisible="{Binding IsRaise}" />
                      <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                              Background="{StaticResource SuccessBrush}"
                              IsVisible="{Binding IsClear}" />
                      <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold"
                                 Text="{Binding Monitor}" />
                      <TextBlock Grid.Column="2" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{Binding When}"
                                 FontFamily="Consolas,Menlo,monospace" />
                    </Grid>

                    <TextBlock Text="{Binding Action}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="18,0,0,0" />
                    <TextBlock Text="{Binding Reason}" FontSize="12" TextWrapping="Wrap" Margin="18,0,0,0" />
                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="18,0,0,0"
                               IsVisible="{Binding Summary, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <TextBlock Text="{Binding Delivery}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="18,2,0,0" />

                    <!-- Молчащий канал опаснее отсутствующего: на него рассчитывают -->
                    <TextBlock Text="{Binding Failures}" FontSize="10" Margin="18,0,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource DangerBrush}"
                               IsVisible="{Binding HasFailures}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </Panel>
        </ScrollViewer>
      </Border>

      <!-- Каналы -->
      <Border Grid.Column="1" Margin="14,0,0,0" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <TextBlock Text="Каналы доставки" FontSize="13" FontWeight="SemiBold" />

            <ItemsControl ItemsSource="{Binding Channels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChannelRow">
                  <StackPanel Spacing="2" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" />
                      <TextBlock Grid.Column="1" FontSize="10" Text="настроен" Foreground="{StaticResource SuccessBrush}"
                                 IsVisible="{Binding IsConfigured}" />
                      <TextBlock Grid.Column="1" FontSize="10" Text="не настроен" Foreground="{StaticResource TextSecondaryBrush}"
                                 IsVisible="{Binding !IsConfigured}" />
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Missing}" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                               IsVisible="{Binding Missing, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <forms:MethodCard Thesis="Ненастроенный канал молчит — и на него при этом рассчитывают."
                              Detail="Пароли хранятся зашифрованными средствами Windows и привязаны к этой учётной записи: копия базы, унесённая на другую машину, их не раскроет — но и не восстановит." />

            <Button Content="Настроить каналы" Command="{Binding ToggleSettingsCommand}"
                    Padding="12,5" HorizontalAlignment="Left" />

            <!-- Настройка там же, где видно, что канал молчит: отправлять чинить
                 это в другую программу — не помощь. Поля строятся по объявлению
                 настроек, поэтому новый ключ появится здесь сам. -->
            <StackPanel Spacing="10" IsVisible="{Binding IsSettingsOpen}">

              <StackPanel Spacing="4">
                <TextBlock Text="HTTP POST на заданный адрес" Classes="label" />
                <ItemsControl ItemsSource="{Binding WebhookFields}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlertSettingField">
                      <StackPanel Spacing="2" Margin="0,0,0,6">
                        <TextBlock Text="{Binding Title}" Classes="caption" />
                        <TextBox Text="{Binding Value}" PlaceholderText="{Binding Placeholder}"
                                 PasswordChar="{Binding IsSecret, Converter={x:Static vm:SecretCharConverter.Instance}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Письмо через SMTP" Classes="label" />
                <ItemsControl ItemsSource="{Binding MailFields}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlertSettingField">
                      <StackPanel Spacing="2" Margin="0,0,0,6">
                        <TextBlock Text="{Binding Title}" Classes="caption" />
                        <TextBox Text="{Binding Value}" PlaceholderText="{Binding Placeholder}"
                                 PasswordChar="{Binding IsSecret, Converter={x:Static vm:SecretCharConverter.Instance}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Сохранить" Command="{Binding SaveSettingsCommand}"
                        Padding="14,6" Background="{StaticResource AccentBrush}" Foreground="White" />
                <TextBlock Text="{Binding SettingsMessage}" Classes="caption" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>

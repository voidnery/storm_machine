<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StormMachine.App.ViewModels"
             xmlns:results="using:StormMachine.Domain.Results"
             xmlns:forms="using:StormMachine.App.Controls"
             x:Class="StormMachine.App.Views.Pages.DashboardPage"
             x:DataType="vm:DashboardPageViewModel">

  <ScrollViewer Padding="24,20">
    <StackPanel Spacing="14" MaxWidth="900" HorizontalAlignment="Left">

      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

      <Border Padding="12,9" CornerRadius="4"
              Background="{StaticResource WarningSurfaceBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
              IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource WarningBrush}" />
      </Border>

      <!-- Первый запуск: путь от «запустил» до «вижу свою сеть» не должен
           требовать чтения документации. -->
      <Border Padding="16" CornerRadius="6" Background="{StaticResource InsetBrush}"
              BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
              IsVisible="{Binding IsFirstRun}">
        <StackPanel Spacing="10">
          <TextBlock Text="С чего начать" FontWeight="SemiBold" FontSize="13" />
          <TextBlock Text="{Binding FirstRunHint}" FontSize="12" TextWrapping="Wrap" />
          <Button Content="Просканировать мою сеть"
                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToCommand}"
                  CommandParameter="/local/discovery"
                  Padding="18,8" HorizontalAlignment="Left"
                  Background="{StaticResource AccentBrush}" Foreground="White" />
        </StackPanel>
      </Border>

      <!-- Окружение -->
      <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="Окружение измерений" FontWeight="SemiBold" FontSize="13" />
          <TextBlock Text="{Binding Privileges}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
          <TextBlock Text="{Binding TimerInfo}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />

          <ItemsControl ItemsSource="{Binding Adapters}" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AdapterRow">
                <!-- Действующий интерфейс помечен словом, а не стрелкой: знак без
                     легенды нечитаем, а колонка под него ещё и сдвигала имена
                     остальных строк относительно помеченной. -->
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                    <Border Classes="chip" VerticalAlignment="Center" IsVisible="{Binding IsPrimary}">
                      <TextBlock Text="меряем отсюда" FontSize="10"
                                 Foreground="{StaticResource InfoBrush}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="12" Margin="12,0"
                             Foreground="{StaticResource WarningBrush}"
                             IsVisible="{Binding IsSuspect}" />
                  <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="12" Margin="12,0" Foreground="{StaticResource TextSecondaryBrush}"
                             IsVisible="{Binding !IsSuspect}" />
                  <TextBlock Grid.Column="2" Text="{Binding Address}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Журнал -->
      <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="16">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Последние прогоны" FontWeight="SemiBold" FontSize="13" />
            <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}"
                    FontSize="12" Padding="10,3" />
          </Grid>

          <!-- Числа плитками, совет строкой: склеенные в одну серую фразу,
               они читались как одна надпись — ни числа, ни совета. -->
          <Grid ColumnDefinitions="Auto,Auto,Auto,*" IsVisible="{Binding HasJournal}">
            <forms:StatTile Grid.Column="0" Width="110" Caption="Прогонов" Value="{Binding RunCountText}" />
            <forms:StatTile Grid.Column="1" Width="130" Caption="Сырых измерений" Value="{Binding SampleCountText}" />
            <forms:StatTile Grid.Column="2" Width="130" Caption="Размер файла" Value="{Binding SizeText}" />
          </Grid>

          <TextBlock Text="{Binding JournalInfo}" Classes="body"
                     Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding JournalInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding InventoryInfo}" Classes="body"
                     Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

          <ItemsControl ItemsSource="{Binding RecentRuns}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="results:RunSummary">
                <Grid ColumnDefinitions="70,Auto,*,Auto,Auto" Margin="0,3">
                  <Border Grid.Column="0" Background="{StaticResource DividerBrush}" CornerRadius="3" Padding="6,1" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding ProbeName}" FontSize="11" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding StartedUtc.LocalDateTime, StringFormat='{}{0:dd.MM HH:mm:ss}'}"
                             FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0" />
                  <TextBlock Grid.Column="2" Text="{Binding TargetDisplay}" FontSize="12"
                             TextTrimming="CharacterEllipsis" Margin="8,0" />
                  <TextBlock Grid.Column="3" Text="{Binding SentCount, StringFormat='{}{0} проб'}"
                             FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0" />
                  <TextBlock Grid.Column="4" Text="{Binding MedianText}"
                             FontSize="12" Margin="8,0" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>

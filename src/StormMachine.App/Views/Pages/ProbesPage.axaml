<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StormMachine.App.ViewModels"
             xmlns:forms="using:StormMachine.App.Controls"
             x:Class="StormMachine.App.Views.Pages.ProbesPage"
             x:DataType="vm:ProbesPageViewModel">

  <UserControl.Styles>
    <Style Selector="Border.step">
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Border.step.fail">
      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
    </Style>
    <Style Selector="Border.step.warn">
      <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
    </Style>
    <Style Selector="Border.step.pass">
      <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24,20">

    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Панель запуска. Шаблон и цель рядом: сценарий без цели не имеет смысла,
         а цель без шаблона не говорит, что с ней делать. -->
    <Border Grid.Row="1" Margin="0,12,0,0" Padding="14" CornerRadius="6"
            Background="{StaticResource PanelBrush}">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="2*,2*,Auto,Auto,Auto">
          <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0">
            <TextBlock Text="Сценарий" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <Grid ColumnDefinitions="*,Auto">
              <!-- Свой шаблон вместо ToString: длинные описания раскрывали список
                   вкривь (замечание оператора, И-24). -->
              <ComboBox Grid.Column="0" ItemsSource="{Binding Templates}" SelectedItem="{Binding Template}"
                        HorizontalAlignment="Stretch" IsEnabled="{Binding CanStart}"
                        MaxDropDownHeight="420">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ScenarioTemplateOption">
                    <StackPanel Spacing="1" MaxWidth="420">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Title}" FontSize="12" />
                        <Border CornerRadius="3" Padding="5,0" Background="{StaticResource ChipBrush}"
                                VerticalAlignment="Center" IsVisible="{Binding !IsTemplate}">
                          <TextBlock Text="свой" FontSize="10" Foreground="{StaticResource InfoBrush}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding About}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Content="Править" FontSize="11" Padding="8,4" Margin="6,0,0,0"
                      Command="{Binding EditSelectedCommand}" IsVisible="{Binding CanEditSelected}" />
            </Grid>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,12,0" MinWidth="320">
            <TextBlock Text="Цель, список через запятую или имя набора" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <!-- Подсказки из инвентаря (И-24): Popup под самим полем, шириной с него. -->
            <Grid ColumnDefinitions="*,Auto">
              <AutoCompleteBox x:Name="TargetBox" Grid.Column="0" Text="{Binding Target}"
                               ItemsSource="{Binding Suggestions}"
                               ItemFilter="{x:Static vm:TargetSuggestions.Filter}"
                               MinimumPrefixLength="1" PlaceholderText="example.com или своё"
                               IsEnabled="{Binding CanStart}">
                <AutoCompleteBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TargetSuggestion">
                    <TextBlock Text="{Binding Description}" FontSize="12" />
                  </DataTemplate>
                </AutoCompleteBox.ItemTemplate>
              </AutoCompleteBox>
              <Button Grid.Column="1" Content="▾" FontSize="11" Padding="8,6" Margin="4,0,0,0"
                      Command="{Binding OpenPickerCommand}"
                      IsEnabled="{Binding CanStart}" ToolTip.Tip="Подставить цель из инвентаря" />
              <Popup PlacementTarget="{Binding #TargetBox}" Placement="BottomEdgeAlignedLeft"
                     IsOpen="{Binding IsPickerOpen, Mode=TwoWay}" IsLightDismissEnabled="True">
                <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="4"
                        Padding="4" MinWidth="{Binding #TargetBox.Bounds.Width}" MaxWidth="480"
                        MaxHeight="300">
                  <ScrollViewer>
                    <StackPanel>
                      <TextBlock Text="Инвентарь пуст — просканируйте сеть в «Обнаружении»."
                                 FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="8,6"
                                 IsVisible="{Binding !Suggestions.Count}" />
                      <ItemsControl ItemsSource="{Binding Suggestions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TargetSuggestion">
                            <Button Content="{Binding Description}" FontSize="12" Padding="8,4"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    Command="{Binding $parent[ItemsControl].((vm:ProbesPageViewModel)DataContext).UseSuggestionCommand}"
                                    CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Bottom">
            <CheckBox IsChecked="{Binding Save}" Content="В журнал" IsEnabled="{Binding CanStart}" />
          </StackPanel>

          <Button Grid.Column="3" Content="Запустить" Margin="0,0,8,0" VerticalAlignment="Bottom"
                  Command="{Binding RunCommand}" Padding="18,7"
                  Background="{StaticResource AccentBrush}" Foreground="White" />

          <Button Grid.Column="4" Content="Стоп" VerticalAlignment="Bottom"
                  Command="{Binding StopCommand}" />
        </Grid>

        <!-- Наборы целей подставляются нажатием: помнить их наизусть незачем. -->
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Наборы:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
          <ItemsControl ItemsSource="{Binding Sets}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Button Content="{Binding}" FontSize="11" Padding="8,3"
                        Command="{Binding $parent[UserControl].((vm:ProbesPageViewModel)DataContext).UseSetCommand}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock Text="{Binding Progress}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                   IsVisible="{Binding IsRunning}" />
        <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- Конструктор. До И-24 своя цепочка собиралась только консолью,
             а экран предлагал готовые шаблоны. -->
        <Expander Header="Собрать свой сценарий" IsExpanded="{Binding Editor.IsOpen}" FontSize="12">
          <StackPanel Spacing="8" Margin="0,8,0,0" DataContext="{Binding Editor}">
            <StackPanel x:DataType="vm:ScenarioEditorViewModel" Spacing="8">

              <forms:MethodCard Thesis="Шаг — это проба с целью, параметрами и порогами."
                                Detail="{x:Static vm:ScenarioEditorViewModel.Note}" />

              <Grid ColumnDefinitions="*,8,2*">
                <TextBox Grid.Column="0" PlaceholderText="имя сценария" Text="{Binding Name}" />
                <TextBox Grid.Column="2" PlaceholderText="что он проверяет (необязательно)"
                         Text="{Binding Description}" />
              </Grid>

              <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ScenarioStepDraftViewModel">
                    <Border Padding="8,6" CornerRadius="4" Background="{StaticResource TileBrush}" Margin="0,2">
                      <Grid ColumnDefinitions="130,*,*,Auto" RowDefinitions="Auto,Auto">

                        <ComboBox Grid.Row="0" Grid.Column="0" Margin="0,0,6,4"
                                  ItemsSource="{Binding $parent[ItemsControl].((vm:ScenarioEditorViewModel)DataContext).ProbeNames}"
                                  SelectedItem="{Binding ProbeName}" HorizontalAlignment="Stretch" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,6,4"
                                 PlaceholderText="цель — пусто: как у предыдущего"
                                 Text="{Binding Target}" FontSize="12" />
                        <TextBox Grid.Row="0" Grid.Column="2" Margin="0,0,6,4"
                                 PlaceholderText="название шага в отчёте"
                                 Text="{Binding Title}" FontSize="12" />

                        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,6,0"
                                 PlaceholderText="параметры: count=4 interval=200"
                                 Text="{Binding ParametersText}" FontSize="12" />
                        <TextBox Grid.Row="1" Grid.Column="2" Margin="0,0,6,0"
                                 PlaceholderText="пороги: p95 &lt; 100; потери &lt;= 0"
                                 Text="{Binding ThresholdsText}" FontSize="12" />

                        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="3"
                                    Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <Button Content="↑" Padding="7,3" FontSize="11"
                                  Command="{Binding $parent[ItemsControl].((vm:ScenarioEditorViewModel)DataContext).MoveUpCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Content="↓" Padding="7,3" FontSize="11"
                                  Command="{Binding $parent[ItemsControl].((vm:ScenarioEditorViewModel)DataContext).MoveDownCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Content="✕" Padding="7,3" FontSize="11"
                                  Command="{Binding $parent[ItemsControl].((vm:ScenarioEditorViewModel)DataContext).RemoveStepCommand}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                <Button Grid.Column="0" Content="Добавить шаг" Command="{Binding AddStepCommand}"
                        Padding="10,5" Margin="0,0,6,0" />
                <Button Grid.Column="1" Content="Сохранить сценарий" Command="{Binding SaveCommand}"
                        Padding="12,5" Margin="0,0,6,0"
                        Background="{StaticResource AccentBrush}" Foreground="White" />
                <Button Grid.Column="2" Content="Удалить" Command="{Binding DeleteCommand}"
                        Padding="10,5" IsVisible="{Binding HasSteps}" />
              </Grid>

              <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                         IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Text="{Binding Error}" FontSize="11" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                         IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

            </StackPanel>
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2" Margin="0,14,0,0" Spacing="2" IsVisible="{Binding HasSteps}">
      <TextBlock Text="{Binding Caption}" FontSize="13" FontWeight="SemiBold" />
      <TextBlock Text="{Binding BaselineCaption}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
    </StackPanel>

    <ScrollViewer Grid.Row="3" Margin="0,10,0,0">
      <StackPanel Spacing="12">

        <ItemsControl ItemsSource="{Binding Steps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ScenarioStepRowViewModel">
              <StackPanel>

                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                           Margin="0,10,0,4" IsVisible="{Binding IsSeparator}" />

                <Border Classes="step" IsVisible="{Binding IsStep}"
                        Classes.pass="{Binding Level, Converter={x:Static vm:VerdictConverters.IsPass}}"
                        Classes.warn="{Binding Level, Converter={x:Static vm:VerdictConverters.IsWarn}}"
                        Classes.fail="{Binding Level, Converter={x:Static vm:VerdictConverters.IsFail}}">
                  <StackPanel Spacing="4">

                    <Grid ColumnDefinitions="Auto,220,90,*">
                      <TextBlock Grid.Column="0" Text="{Binding Mark}" FontFamily="Consolas"
                                 Width="18" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" />
                      <TextBlock Grid.Column="2" Text="{Binding Measured}" FontFamily="Consolas"
                                 HorizontalAlignment="Right" Margin="0,0,10,0" />
                      <Rectangle Grid.Column="3" Height="10" HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Width="{Binding BarWidth}" Fill="{StaticResource AccentBrush}" />
                    </Grid>

                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="18,0,0,0" />

                    <TextBlock Text="{Binding Explanation}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="18,0,0,0"
                               IsVisible="{Binding Explanation, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <!-- Находки проб: пороги ставят на числа, а расхождение резолверов
                         и истекающий сертификат числами не являются. -->
                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="18,0,0,0"
                                  IsVisible="{Binding HasWarnings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource WarningBrush}"
                                     TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="18,6,0,0" Spacing="2" IsVisible="{Binding HasParts}">
                      <TextBlock Text="{Binding PartsCaption}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                      <ItemsControl ItemsSource="{Binding Parts}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ScenarioPartRow">
                            <Grid ColumnDefinitions="160,80,44,*" Margin="0,1">
                              <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11"
                                         />
                              <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11"
                                         FontFamily="Consolas" HorizontalAlignment="Right"
                                         Margin="0,0,10,0" />
                              <TextBlock Grid.Column="2" Text="{Binding ShareText}" FontSize="11"
                                         Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,0,10,0" />
                              <Rectangle Grid.Column="3" Height="6" HorizontalAlignment="Left"
                                         VerticalAlignment="Center" Width="{Binding BarWidth}"
                                         Fill="{StaticResource AccentBrush}" Opacity="0.5" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                  </StackPanel>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Ключевая методическая оговорка экрана: шаги измеряют пересекающиеся
             отрезки и не складываются. До волны 3 — мелким серым под шагами. -->
        <forms:MethodCard Thesis="{Binding Note}" IsVisible="{Binding HasSteps}" />

        <!-- Сводка по набору: одна упавшая цель из пяти и пять из пяти —
             разные неисправности. -->
        <Border Padding="12" CornerRadius="6" Background="{StaticResource PanelBrush}"
                IsVisible="{Binding HasTargets}">
          <StackPanel Spacing="6">
            <TextBlock Text="Итог по целям" FontSize="13" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Targets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ScenarioTargetRow">
                  <Grid ColumnDefinitions="Auto,240,150,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Mark}" FontFamily="Consolas" Width="18" />
                    <TextBlock Grid.Column="1" Text="{Binding Target}" />
                    <TextBlock Grid.Column="2" Text="{Binding Verdict}" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding Where}" Foreground="{StaticResource TextSecondaryBrush}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <forms:VerdictLine Text="{Binding Conclusion}" Level="{Binding ConclusionLevel}" Margin="0,0,0,20" />

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

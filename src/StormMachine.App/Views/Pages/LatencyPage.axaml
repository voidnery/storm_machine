<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StormMachine.App.ViewModels"
             xmlns:controls="using:StormMachine.App.Controls"
             xmlns:sp="using:ScottPlot.Avalonia"
             xmlns:results="using:StormMachine.Domain.Results"
             x:Class="StormMachine.App.Views.Pages.LatencyPage"
             x:DataType="vm:LatencyPageViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="24,20">

    <!-- Заголовок. Условия измерения — бейджами: их сравнивают между запусками,
         а в предложении границы значений искать глазами. -->
    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock Text="{Binding Title}" Classes="h1" />
      <ItemsControl ItemsSource="{Binding Conditions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ConditionRow">
            <controls:ConditionBadge Label="{Binding Label}" Value="{Binding Value}" Margin="0,0,6,4" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Предупреждение об окружении -->
    <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,8" CornerRadius="4"
            Background="{StaticResource WarningSurfaceBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
            IsVisible="{Binding TimingWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding TimingWarning}" TextWrapping="Wrap" FontSize="12"
                 Foreground="{StaticResource WarningBrush}" />
    </Border>

    <!-- Панель запуска -->
    <Border Grid.Row="2" Margin="0,12,0,0" Padding="14" CornerRadius="6"
            Background="{StaticResource PanelBrush}">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="2*,Auto,Auto,Auto,Auto" >
          <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0" MinWidth="320">
            <TextBlock Text="Цель" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <!-- Подсказки из инвентаря (И-24): набор фильтрует список, кнопка ▾ открывает
                 его целиком. Список — Popup, привязанный к самому полю и шириной с него:
                 выпадение из кнопки открывалось вкривь (замечание оператора). -->
            <Grid ColumnDefinitions="*,Auto">
              <AutoCompleteBox x:Name="TargetBox" Grid.Column="0" Text="{Binding TargetText}"
                               ItemsSource="{Binding Suggestions}"
                               ItemFilter="{x:Static vm:TargetSuggestions.Filter}"
                               MinimumPrefixLength="1" PlaceholderText="gateway, 192.168.1.1 или example.com"
                               IsEnabled="{Binding CanStart}">
                <AutoCompleteBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TargetSuggestion">
                    <TextBlock Text="{Binding Description}" FontSize="12" />
                  </DataTemplate>
                </AutoCompleteBox.ItemTemplate>
              </AutoCompleteBox>
              <Button Grid.Column="1" Content="▾" FontSize="11" Padding="8,6" Margin="4,0,0,0"
                      Command="{Binding OpenPickerCommand}"
                      IsEnabled="{Binding CanStart}" ToolTip.Tip="Подставить цель из инвентаря" />
              <Popup PlacementTarget="{Binding #TargetBox}" Placement="BottomEdgeAlignedLeft"
                     IsOpen="{Binding IsPickerOpen, Mode=TwoWay}" IsLightDismissEnabled="True">
                <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="4"
                        Padding="4" MinWidth="{Binding #TargetBox.Bounds.Width}" MaxWidth="480"
                        MaxHeight="300">
                  <ScrollViewer>
                    <StackPanel>
                      <TextBlock Text="Инвентарь пуст — просканируйте сеть в «Обнаружении»."
                                 FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="8,6"
                                 IsVisible="{Binding !Suggestions.Count}" />
                      <ItemsControl ItemsSource="{Binding Suggestions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TargetSuggestion">
                            <Button Content="{Binding Description}" FontSize="12" Padding="8,4"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    Command="{Binding $parent[ItemsControl].((vm:LatencyPageViewModel)DataContext).UseSuggestionCommand}"
                                    CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </StackPanel>

          <!-- Ширина 140: у NumericUpDown стрелки съедают место, и «100» в 110 px
               обрезалось (замечание оператора, И-24). -->
          <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,12,0" Width="140">
            <TextBlock Text="Интервал, мс" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <NumericUpDown Value="{Binding IntervalMs}" Minimum="10" Maximum="600000" Increment="100"
                           FormatString="0" IsEnabled="{Binding CanStart}" />
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="4" Margin="0,0,12,0" Width="140">
            <TextBlock Text="Число проб" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <NumericUpDown Value="{Binding Count}" Minimum="1" Maximum="1000000" Increment="10"
                           FormatString="0"
                           IsEnabled="{Binding !Continuous}" />
          </StackPanel>

          <StackPanel Grid.Column="3" Spacing="8" Margin="0,0,14,0" VerticalAlignment="Bottom">
            <CheckBox IsChecked="{Binding Continuous}" Content="Непрерывно" FontSize="12"
                      IsEnabled="{Binding CanStart}" />
            <CheckBox IsChecked="{Binding SaveToJournal}" Content="Писать в журнал" FontSize="12"
                      IsEnabled="{Binding CanStart}" />
          </StackPanel>

          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
            <Button Content="Запустить" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"
                    Padding="18,7" Background="{StaticResource AccentBrush}" Foreground="White" />
            <Button Content="Остановить" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"
                    Padding="14,7" />
          </StackPanel>
        </Grid>

        <!-- Сквозной принцип: пресет рождается не из формы, а из измерения,
             которое только что оказалось полезным. -->
        <Grid ColumnDefinitions="Auto,220,Auto,*">
          <TextBlock Grid.Column="0" Text="Сохранить как пресет:" Classes="body"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBox Grid.Column="1" Text="{Binding PresetName}" PlaceholderText="имя пресета" FontSize="12" />
          <Button Grid.Column="2" Content="Сохранить" Command="{Binding SaveAsPresetCommand}"
                  FontSize="12" Padding="12,5" Margin="8,0,0,0" />
        </Grid>

        <!-- Статусу — постоянное место под панелью запуска. Справа от имени пресета
             он терялся, и «идёт» от «кончилось отказом» ничем не отличалось. -->
        <controls:StatusLine Text="{Binding StatusLine}" State="{Binding StatusState}" />

        <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Border>

    <!-- График и история -->
    <Grid Grid.Row="3" ColumnDefinitions="*,300" Margin="0,14,0,0">

      <Border Grid.Column="0" CornerRadius="6" Background="{StaticResource SurfaceBrush}" Padding="6">
        <sp:AvaPlot Name="Chart" />
      </Border>

      <Border Grid.Column="1" Margin="14,0,0,0" CornerRadius="6"
              Background="{StaticResource PanelBrush}" Padding="12">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,8">
            <TextBlock Text="История прогонов" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="Сохранённые измерения ping. Выбери — покажу на графике."
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
          </StackPanel>

          <ListBox Grid.Row="1" Name="HistoryList" ItemsSource="{Binding History}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="results:RunSummary">
                <StackPanel Spacing="1" Margin="0,3">
                  <TextBlock Text="{Binding TargetDisplay}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0:dd.MM HH:mm:ss} · {1} проб · {2:0.0}% потерь">
                        <Binding Path="StartedUtc.LocalDateTime" />
                        <Binding Path="SentCount" />
                        <Binding Path="LossPercent" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="6,2" />
              </Style>
            </ListBox.Styles>
          </ListBox>

          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Обновить" Command="{Binding RefreshHistoryCommand}" FontSize="12" Padding="10,4" />
            <Button Content="Показать" FontSize="12" Padding="10,4"
                    Command="{Binding LoadRunCommand}"
                    CommandParameter="{Binding #HistoryList.SelectedItem}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Показатели -->
    <Border Grid.Row="4" Margin="0,14,0,0" Padding="14,10" CornerRadius="6"
            Background="{StaticResource PanelBrush}">
      <Grid ColumnDefinitions="*,*,*,*,*,*">
        <controls:StatTile Grid.Column="0" Caption="Отправлено" Value="{Binding Sent}" />
        <controls:StatTile Grid.Column="1" Caption="Потери" Value="{Binding Loss}" />
        <controls:StatTile Grid.Column="2" Caption="Последнее" Value="{Binding Last}" />
        <controls:StatTile Grid.Column="3" Caption="Медиана" Value="{Binding Median}" />
        <controls:StatTile Grid.Column="4" Caption="Джиттер RFC 3550" Value="{Binding Jitter}" />
        <controls:StatTile Grid.Column="5" Caption="PDV (p99 − p50)" Value="{Binding Pdv}" />
      </Grid>
    </Border>

  </Grid>
</UserControl>

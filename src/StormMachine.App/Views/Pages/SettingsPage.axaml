<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StormMachine.App.ViewModels"
             xmlns:forms="using:StormMachine.App.Controls"
             x:Class="StormMachine.App.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">

  <Grid RowDefinitions="Auto,*" Margin="24,20">

    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
        <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}" Padding="12,5" />
      </Grid>

      <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource DangerBrush}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,0,10,20">

        <!-- Карточки по смыслу (перестановка И-24 по замечанию оператора): слева то,
             что определяет измерения (профили) и вторую точку (агенты); справа опрос
             оборудования и данные; «О продукте» — полосой внизу. Колонки независимы:
             в сетке 2×2 высота строки равнялась высоте длинной карточки, и под
             короткой зияла пустота в пол-экрана. -->
        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="14" Margin="0,0,7,14">

        <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="16">
          <StackPanel Spacing="10">

            <TextBlock Text="Профили окружения" Classes="h2" />

            <forms:MethodCard Thesis="Порог 50 мс, разумный в офисе, бессмыслен для канала до филиала через VPN."
                                 Detail="Активный профиль пишется в условия каждого измерения — иначе через полгода отличить замер у заказчика от замера в офисе будет нечем." />

            <StackPanel Spacing="2">
              <TextBlock Text="Приметы текущей сети" Classes="caption" />
              <TextBlock Text="{Binding CurrentSignature}" Classes="label" TextWrapping="Wrap" />
            </StackPanel>

            <Button Content="Узнать, где мы" Command="{Binding DetectCommand}" Padding="12,5"
                    HorizontalAlignment="Left" />

            <Border Padding="10,8" CornerRadius="4" Background="{StaticResource TileBrush}"
                    IsVisible="{Binding Guess, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding Guess}" FontSize="11" TextWrapping="Wrap" LineHeight="16" />
            </Border>

            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                     Background="Transparent" BorderThickness="0" MaxHeight="220">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                    <StackPanel Grid.Column="0" Spacing="1">
                      <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Signature}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Extras}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="активен" FontSize="10" VerticalAlignment="Center"
                               Foreground="{StaticResource SuccessBrush}" IsVisible="{Binding IsActive}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Grid ColumnDefinitions="*,Auto,Auto">
              <Button Grid.Column="0" Content="Сделать активным" Command="{Binding ActivateProfileCommand}"
                      Padding="12,5" HorizontalAlignment="Left"
                      Background="{StaticResource AccentBrush}" Foreground="White" />
              <Button Grid.Column="1" Content="Снять" Command="{Binding ClearProfileCommand}"
                      Padding="10,5" Margin="0,0,6,0" />
              <Button Grid.Column="2" Content="Удалить" Command="{Binding DeleteProfileCommand}" Padding="10,5" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
              <TextBox Grid.Column="0" PlaceholderText="имя нового профиля" Text="{Binding NewProfileName}" />
              <Button Grid.Column="1" Content="Запомнить это место" Command="{Binding CaptureHereCommand}"
                      Padding="12,5" Margin="6,0,0,0" />
            </Grid>

            <forms:MethodCard Thesis="Продукт узнаёт сеть, но не переключает профиль сам."
                                 Detail="Смена профиля меняет пороги и состав работающих мониторов, а делать это молча значит поменять смысл измерений за спиной оператора." />

          </StackPanel>
        </Border>

        <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="16">
          <StackPanel Spacing="10">

            <!-- Агенты.

                 Раздел закрывает долг, который тянулся с И-12: три пробы уровня 0 —
                 пропускная способность, качество канала и задержка под нагрузкой —
                 требуют сопряжённого агента, а сопрягать можно было только из консоли.
                 Экран возможностей показывал их с причиной «нужна вторая точка измерения»
                 и консольной командой в качестве совета: кто поставил графический
                 клиент, попадал в тупик. -->
            <StackPanel Spacing="10" DataContext="{Binding Agents}">
              <StackPanel x:DataType="vm:AgentsSectionViewModel" Spacing="10">

                <TextBlock Text="Агенты" Classes="h2" />

                <forms:MethodCard Thesis="Вторая точка измерения."
                                     Detail="Без неё пропускная способность, качество канала и задержка под нагрузкой измерены быть не могут: скорость между точками требует двух точек." />

                <StackPanel Spacing="3"
                            IsVisible="{Binding OwnThumbprint, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Text="Наш отпечаток сертификата — его называют тому, кто у агента" Classes="caption" />
                  <!-- Отпечаток диктуют по телефону или шлют сообщением: чип копируется -->
                  <forms:CopyChip Text="{Binding OwnThumbprint}" />
                </StackPanel>

                <TextBlock Text="Сопряжённых агентов нет." Classes="label"
                           IsVisible="{Binding !HasAgents}" />

                <ListBox ItemsSource="{Binding Agents}" SelectedItem="{Binding Selected}"
                         Background="Transparent" BorderThickness="0" MaxHeight="160"
                         IsVisible="{Binding HasAgents}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AgentRow">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                        <StackPanel Grid.Column="0" Spacing="1">
                          <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Where}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Thumbprint}" FontSize="10"
                                   FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <Grid ColumnDefinitions="Auto,Auto,*" IsVisible="{Binding HasAgents}">
                  <Button Grid.Column="0" Content="Проверить связь" Command="{Binding CheckCommand}"
                          Padding="10,5" Margin="0,0,6,0" />
                  <Button Grid.Column="1" Content="Забыть" Command="{Binding ForgetCommand}" Padding="10,5" />
                </Grid>

                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,2" />

                <TextBlock Text="Сопрячь новый" Classes="label" FontWeight="SemiBold" />

                <!-- Два способа, потому что соединение устанавливает любая сторона:
                     входящие на Windows заблокированы по умолчанию, а правило требует
                     администратора. Где прав нет — звонит агент. -->
                <forms:MethodCard Thesis="Звонить самим — когда на машине агента разрешены входящие."
                                     Detail="Ждать звонка — когда прав там нет: исходящие разрешены всегда." />

                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" PlaceholderText="адрес агента или адрес:порт"
                           Text="{Binding Host}" IsEnabled="{Binding !IsBusy}" />
                  <Button Grid.Column="1" Content="Найти в сети" Command="{Binding BrowseCommand}"
                          Padding="10,5" Margin="6,0,0,0" />
                </Grid>

                <ListBox ItemsSource="{Binding Found}" SelectedItem="{Binding SelectedFound}"
                         Background="Transparent" BorderThickness="0" MaxHeight="110"
                         IsVisible="{Binding Found.Count}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DiscoveredAgentRow">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0" Spacing="1">
                          <TextBlock Text="{Binding Name}" FontSize="11" />
                          <TextBlock Text="{Binding Where}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="Взять этот адрес" Command="{Binding UseFoundCommand}" Padding="10,4"
                        FontSize="11" HorizontalAlignment="Left" IsVisible="{Binding Found.Count}" />

                <TextBox PlaceholderText="код сопряжения от агента" Text="{Binding Code}"
                         IsEnabled="{Binding !IsBusy}" />

                <Grid ColumnDefinitions="Auto,Auto,*">
                  <Button Grid.Column="0" Content="Позвонить" Command="{Binding DialCommand}"
                          Padding="12,5" Margin="0,0,6,0" IsEnabled="{Binding !IsBusy}"
                          Background="{StaticResource AccentBrush}" Foreground="White" />
                  <Button Grid.Column="1" Content="Ждать звонка" Command="{Binding WaitForCallCommand}"
                          Padding="12,5" Margin="0,0,6,0" IsEnabled="{Binding !IsBusy}" />
                  <Button Grid.Column="2" Content="Отменить" Command="{Binding StopCommand}"
                          Padding="10,5" HorizontalAlignment="Left" IsVisible="{Binding IsBusy}" />
                </Grid>

                <!-- Ход сопряжения показывается здесь, а не уходит в консоль:
                     у графического клиента её нет. Именно так в И-19 пропадала
                     просьба «набери на второй машине вот это». -->
                <Border Classes="tile" Padding="10,8"
                        IsVisible="{Binding Progress, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Text="{Binding Progress}" Classes="label" Foreground="{StaticResource TextBrush}"
                             TextWrapping="Wrap" LineHeight="16" />
                </Border>

                <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding Error}" FontSize="11" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <forms:Caveat Text="Отпечаток сверяется глазами и всегда: объявление о себе в сети подделать может кто угодно, и поиск избавляет от набора адреса — только от этого." />

              </StackPanel>
            </StackPanel>

          </StackPanel>
        </Border>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="14" Margin="7,0,0,14">

        <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="16">
          <StackPanel Spacing="10">

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="Учётные данные SNMP" Classes="h2"
                         ToolTip.Tip="SNMP — стандартный протокол опроса сетевого оборудования: порты коммутаторов, соседи, счётчики" />
              <Button Grid.Column="1" Content="Завести" Padding="10,3" FontSize="11"
                      Command="{Binding ToggleCredentialEditorCommand}" />
            </Grid>

            <forms:MethodCard Thesis="{x:Static vm:SettingsPageViewModel.SnmpNote}"
                                 Detail="{x:Static vm:SettingsPageViewModel.SnmpNoteWhy}" />

            <TextBlock Text="Наборов нет — опрашивать оборудование нечем." Classes="label"
                       IsVisible="{Binding !Credentials.Count}" />

            <ListBox ItemsSource="{Binding Credentials}" SelectedItem="{Binding SelectedCredential}"
                     Background="Transparent" BorderThickness="0" MaxHeight="160"
                     IsVisible="{Binding Credentials.Count}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CredentialRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                    <StackPanel Grid.Column="0" Spacing="1">
                      <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding About}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Защищает набор что-нибудь или нет — видно сразу: строка сообщества
                         идёт открытым текстом и защитой не является. -->
                    <TextBlock Grid.Column="1" Text="открыто" FontSize="10" VerticalAlignment="Center"
                               Foreground="{StaticResource WarningBrush}"
                               IsVisible="{Binding !IsProtected}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Форма набора -->
            <Border Padding="12,10" CornerRadius="4" Background="{StaticResource TileBrush}"
                    IsVisible="{Binding IsCredentialEditorOpen}">
              <StackPanel Spacing="8" DataContext="{Binding Editor}">
                <StackPanel x:DataType="vm:SnmpCredentialEditorViewModel" Spacing="8">

                  <TextBox PlaceholderText="имя набора: «свитчи», «ядро»" Text="{Binding Name}" />

                  <forms:Picker ItemsSource="{Binding Versions}" SelectedItem="{Binding Version, Mode=TwoWay}" />

                  <StackPanel Spacing="6" IsVisible="{Binding IsCommunity}">
                    <TextBox PlaceholderText="строка сообщества" Text="{Binding Community}"
                             PasswordChar="•" />
                    <!-- Не методика, а оговорка: набор со строкой сообщества ничего
                         не защищает, и сказать об этом надо голосом предупреждения. -->
                    <forms:Caveat Text="{x:Static vm:SnmpCredentialEditorViewModel.CommunityNote}" />
                  </StackPanel>

                  <StackPanel Spacing="6" IsVisible="{Binding IsV3}">
                    <TextBox PlaceholderText="имя пользователя" Text="{Binding UserName}" />

                    <forms:Picker ItemsSource="{Binding Auths}" SelectedItem="{Binding Auth, Mode=TwoWay}" />
                    <TextBox PlaceholderText="пароль проверки подлинности" Text="{Binding AuthPassword}"
                             PasswordChar="•" IsVisible="{Binding NeedsAuthPassword}" />

                    <forms:Picker ItemsSource="{Binding Privacies}" SelectedItem="{Binding Privacy, Mode=TwoWay}" />
                    <TextBox PlaceholderText="пароль шифрования" Text="{Binding PrivacyPassword}"
                             PasswordChar="•" IsVisible="{Binding NeedsPrivacyPassword}" />
                  </StackPanel>

                  <Grid ColumnDefinitions="*,8,*">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="Порт" Classes="caption" />
                      <NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" Increment="1"
                                     FormatString="0" />
                      <!-- Подсказка была написана и никуда не привязана: оператор
                           не узнавал ни про 161, ни про то, что порт нестандартный. -->
                      <TextBlock Text="{Binding PortHint}" Classes="caption" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                      <TextBlock Text="Порядок перебора" Classes="caption" />
                      <NumericUpDown Value="{Binding Order}" Minimum="0" Maximum="99" Increment="1"
                                     FormatString="0" />
                      <TextBlock Text="Меньше — пробуется раньше" Classes="caption" />
                    </StackPanel>
                  </Grid>

                  <forms:MethodCard Thesis="{x:Static vm:SnmpCredentialEditorViewModel.PasswordNote}"
                                       Detail="{x:Static vm:SnmpCredentialEditorViewModel.PasswordNoteWhy}" />

                  <Border Classes="inset" Padding="10,8">
                    <TextBlock Text="{Binding Preview}" Classes="label" Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" LineHeight="16" />
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsCredentialEditorOpen}">
              <Button Grid.Column="0" Content="Отмена" Padding="12,5" HorizontalAlignment="Left"
                      Command="{Binding ToggleCredentialEditorCommand}" />
              <Button Grid.Column="1" Content="Завести набор" Padding="14,5"
                      Background="{StaticResource AccentBrush}" Foreground="White"
                      Command="{Binding AddCredentialCommand}" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox Grid.Column="0" PlaceholderText="адрес устройства для проверки"
                       Text="{Binding ProbeHost}" />
              <Button Grid.Column="1" Content="Проверить" Padding="12,5" Margin="6,0,6,0"
                      Command="{Binding ProbeCommand}" />
              <Button Grid.Column="2" Content="Удалить" Padding="12,5"
                      Command="{Binding DeleteCredentialCommand}" />
            </Grid>

            <Border Classes="tile" Padding="10,8"
                    IsVisible="{Binding ProbeResult, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding ProbeResult}" Classes="label" Foreground="{StaticResource TextBrush}"
                         TextWrapping="Wrap" LineHeight="16" />
            </Border>

          </StackPanel>
        </Border>

        <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="16">
          <StackPanel Spacing="10">

            <TextBlock Text="Хранилище" Classes="h2" />

            <forms:CopyChip Text="{Binding DatabasePath}" />

            <forms:MethodCard Thesis="{x:Static vm:SettingsPageViewModel.StorageNote}"
                                 Detail="{x:Static vm:SettingsPageViewModel.StorageNoteWhy}" />

            <!-- Два способа назвать другой файл — чипами: их набирают руками
                 и ошибаются в имени переменной. -->
            <StackPanel Spacing="4">
              <TextBlock Text="Другой файл базы задаётся так" Classes="caption" />
              <WrapPanel>
                <forms:CopyChip Text="{x:Static vm:SettingsPageViewModel.StoragePathVariable}"
                                   Margin="0,0,6,4" />
                <forms:CopyChip Text="--база" Margin="0,0,6,4" />
              </WrapPanel>
            </StackPanel>

            <!-- Политика хранения. До И-24 жила только умолчаниями и ключами консоли. -->
            <StackPanel Spacing="10" DataContext="{Binding Retention}">
              <StackPanel x:DataType="vm:RetentionSectionViewModel" Spacing="10">

                <TextBlock Text="Политика хранения" Classes="h2" />

                <forms:MethodCard Thesis="{x:Static vm:RetentionSectionViewModel.Note}"
                                     Detail="{x:Static vm:RetentionSectionViewModel.NoteWhy}" />

                <StackPanel Spacing="4">
                  <TextBlock Text="Та же уборка из консоли" Classes="caption" />
                  <forms:CopyChip Text="{x:Static vm:RetentionSectionViewModel.PurgeCommand}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,8,*">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Сырые измерения, дней" Classes="caption" ToolTip.Tip="Каждый отдельный отсчёт прогона. Их больше всего, и место занимают они" />
                    <NumericUpDown Value="{Binding RawDays}" Minimum="1" Maximum="3650" Increment="1"
                                   FormatString="0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="Прогоны со сводками, дней" Classes="caption" ToolTip.Tip="Сводка — итоги прогона без отдельных отсчётов: медиана, потери, джиттер. По ним работают история и отчёты" />
                    <NumericUpDown Value="{Binding RunDays}" Minimum="1" Maximum="3650" Increment="1"
                                   FormatString="0" />
                  </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                  <Button Grid.Column="0" Content="Сохранить" Command="{Binding SaveCommand}"
                          Padding="12,5" Margin="0,0,6,0"
                          Background="{StaticResource AccentBrush}" Foreground="White" />
                  <Button Grid.Column="1" Content="Прикинуть уборку" Command="{Binding PreviewCommand}"
                          Padding="12,5" Margin="0,0,6,0" />
                  <Button Grid.Column="2" Content="Прибраться сейчас" Command="{Binding CleanupNowCommand}"
                          Padding="12,5" />
                </Grid>

                <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding Error}" FontSize="11" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

              </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,6" />

            <!-- Перенос настроек. Механизм И-22 (сценарии — И-23), экранная форма — И-24:
                 «настроил у себя, разворачиваю у заказчика» — сценарий и того,
                 кто консолью не пользуется. -->
            <StackPanel Spacing="10" DataContext="{Binding Transfer}">
              <StackPanel x:DataType="vm:TransferSectionViewModel" Spacing="10">

                <TextBlock Text="Перенос настроек" Classes="h2" />

                <forms:MethodCard Thesis="{x:Static vm:TransferSectionViewModel.Note}"
                                     Detail="{x:Static vm:TransferSectionViewModel.NoteWhy}" />

                <!-- Чего перенос не делает — голосом предупреждения, а рядом команды,
                     которыми заводят заново то, что не переехало. -->
                <forms:Caveat Text="{x:Static vm:TransferSectionViewModel.SecretsCaveat}" />
                <WrapPanel>
                  <forms:CopyChip Text="{x:Static vm:TransferSectionViewModel.SnmpCredsCommand}"
                                     Margin="0,0,6,4" />
                  <forms:CopyChip Text="{x:Static vm:TransferSectionViewModel.AlertsCommand}"
                                     Margin="0,0,6,4" />
                </WrapPanel>

                <Grid ColumnDefinitions="Auto,Auto,*">
                  <Button Grid.Column="0" Content="Выгрузить в файл" Command="{Binding ExportCommand}"
                          Padding="12,5" Margin="0,0,6,0" />
                  <Button Grid.Column="1" Content="Загрузить из файла" Command="{Binding ImportCommand}"
                          Padding="12,5" />
                </Grid>

                <CheckBox Content="Не трогать существующие — только добавлять новое"
                          IsChecked="{Binding KeepExisting}" FontSize="11" />

                <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding Error}" FontSize="11" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

              </StackPanel>
            </StackPanel>

          </StackPanel>
        </Border>
        </StackPanel>

        <!-- О продукте — полосой на всю ширину: это справка, а не настройка. -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="16">
          <StackPanel Spacing="10">

            <TextBlock Text="О продукте" Classes="h2" />

            <StackPanel Spacing="3">
              <TextBlock Text="Версия" Classes="caption" />
              <forms:CopyChip Text="{x:Static vm:SettingsPageViewModel.Version}" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="Обновление" Classes="caption" />
              <TextBlock Text="{Binding Updates.StateText}" Classes="label" TextWrapping="Wrap" LineHeight="16" />

              <forms:Caveat Text="{Binding Updates.Hold}" />

              <Grid ColumnDefinitions="Auto,Auto,Auto">
                <Button Grid.Column="0" Content="Проверить" Padding="12,5" Margin="0,0,6,0"
                        Command="{Binding CheckUpdateCommand}" IsEnabled="{Binding Updates.CanCheck}" />
                <Button Grid.Column="1" Content="Скачать" Padding="12,5" Margin="0,0,6,0"
                        Command="{Binding DownloadUpdateCommand}" IsEnabled="{Binding Updates.CanDownload}" />
                <Button Grid.Column="2" Content="Установить и перезапустить" Padding="12,5"
                        Command="{Binding ApplyUpdateCommand}" IsEnabled="{Binding Updates.CanApply}"
                        Background="{StaticResource AccentBrush}" Foreground="White" />
              </Grid>

              <forms:MethodCard Thesis="{x:Static vm:SettingsPageViewModel.UpdateNote}"
                                   Detail="{x:Static vm:SettingsPageViewModel.UpdateNoteWhy}" />
            </StackPanel>

            <forms:MethodCard Thesis="{x:Static vm:SettingsPageViewModel.LicenceNote}"
                                 Detail="{x:Static vm:SettingsPageViewModel.LicenceNoteWhy}" />

          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StormMachine.App.ViewModels"
             xmlns:forms="using:StormMachine.App.Controls"
             xmlns:discovery="using:StormMachine.Domain.Discovery"
             x:Class="StormMachine.App.Views.Pages.DevicesPage"
             x:DataType="vm:DevicesPageViewModel">

  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="6,2" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="24,20">

    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Правка оператора: не запись в поле, а свидетельство с наивысшим весом -->
    <Border Grid.Row="1" Margin="0,12,0,0" Padding="14,10" CornerRadius="6"
            Background="{StaticResource PanelBrush}">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="Auto,240,Auto,Auto,190,Auto,Auto,*">
          <TextBlock Grid.Column="0" Text="Назвать выбранное:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                     VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBox Grid.Column="1" Text="{Binding NewName}" PlaceholderText="как называть это устройство"
                   FontSize="12" />
          <Button Grid.Column="2" Content="Сохранить" Command="{Binding RenameCommand}"
                  FontSize="12" Padding="12,5" Margin="8,0,0,0" />

          <!-- Роль: комбо со свободным вводом. Классификатор ошибается — правка
               оператора весит больше и переживает пересканирование (И-24). -->
          <TextBlock Grid.Column="3" Text="Роль:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                     VerticalAlignment="Center" Margin="16,0,8,0" />
          <forms:Picker Grid.Column="4" AcceptsText="True" Text="{Binding NewRole, Mode=TwoWay}"
                        ItemsSource="{Binding RoleOptions}" Placeholder="из списка или своя" />
          <Button Grid.Column="5" Content="Присвоить" Command="{Binding AssignRoleCommand}"
                  FontSize="12" Padding="12,5" Margin="8,0,0,0" />

          <Button Grid.Column="6" Content="Обновить" Command="{Binding RefreshCommand}"
                  FontSize="12" Padding="12,5" Margin="8,0,0,0" />
          <forms:StatusLine Grid.Column="7" Text="{Binding StatusLine}"
                            VerticalAlignment="Center" Margin="16,0,0,0" />
        </Grid>

        <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,340" Margin="0,14,0,0">

      <Border Grid.Column="0" CornerRadius="6" Background="{StaticResource SurfaceBrush}" Padding="10">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="130,150,*,180,90" Margin="8,0,4,6">
            <TextBlock Grid.Column="0" Text="адрес" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock Grid.Column="1" Text="MAC" Classes="label" ToolTip.Tip="Аппаратный адрес сетевой карты" />
            <TextBlock Grid.Column="2" Text="имя" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock Grid.Column="3" Text="производитель" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock Grid.Column="4" Text="последний ответ" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
          </Grid>

          <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:InventoryRow">
                <!-- Внутренняя сетка имени вместо горизонтального StackPanel: панель
                     меряется бесконечной шириной и на узком окне рисовалась поверх
                     колонки вендора (замечание оператора, И-24). Сетка режет имя
                     троеточием, а значки и тег остаются видны. -->
                <Grid ColumnDefinitions="130,150,*,180,90" Opacity="{Binding IsOnline, Converter={x:Static vm:OpacityConverter.Instance}}">
                  <StackPanel Grid.Column="0" Spacing="0">
                    <TextBlock Text="{Binding Address}" FontSize="12" />
                    <TextBlock Text="{Binding ExtraAddresses}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding ExtraAddresses, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding MacAddress}" FontSize="12" />
                  <Grid Grid.Column="2" ColumnDefinitions="*,Auto,Auto" Margin="0,0,8,0">
                    <TextBlock Grid.Column="0" Text="{Binding HostName}" FontSize="12"
                               HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="✎" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,0,0"
                               ToolTip.Tip="Имя присвоено оператором — переживает пересканирование"
                               IsVisible="{Binding IsNamedByOperator}" />
                    <!-- Тег категории. Вопрос — догадка классификатора, без — наблюдение
                         или правка оператора. -->
                    <Border Grid.Column="2" CornerRadius="3" Padding="6,1" Background="{StaticResource ChipBrush}"
                            VerticalAlignment="Center" Margin="6,0,0,0"
                            IsVisible="{Binding Role, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding Role}" FontSize="10" Foreground="{StaticResource InfoBrush}" />
                    </Border>
                  </Grid>
                  <TextBlock Grid.Column="3" Text="{Binding Vendor}" FontSize="12"
                             TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                  <TextBlock Grid.Column="4" Text="{Binding LastSeen}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Легенда парами: в одном предложении, чтобы понять один знак,
               приходилось прочитать про оба. -->
          <StackPanel Grid.Row="2" Margin="8,8,4,0" Spacing="3">
            <forms:LegendPair Sign="приглушённая строка"
                              Meaning="устройство известно, но в последнем сканировании не ответило" />
            <forms:LegendPair Sign="✎ у имени"
                              Meaning="имя присвоено оператором: оно сильнее любого наблюдения" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" Margin="14,0,0,0" CornerRadius="6"
              Background="{StaticResource PanelBrush}" Padding="12">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,8">
            <TextBlock Text="Что изменилось" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="Выберите раннее сканирование — сравню его с последним."
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
          </StackPanel>

          <forms:Picker Grid.Row="1" ItemsSource="{Binding Scans}"
                        SelectedItem="{Binding CompareFrom, Mode=TwoWay}"
                        Placeholder="выберите сканирование"
                        Empty="Сканирований ещё не было — начните с «Обнаружения»." />

          <Button Grid.Row="2" Content="Сравнить с последним" Command="{Binding CompareCommand}"
                  FontSize="12" Padding="12,5" Margin="0,8,0,8" HorizontalAlignment="Stretch" />

          <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding Differences}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontSize="11" Margin="0,2" TextWrapping="Wrap"
                             FontFamily="Consolas,Menlo,monospace" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

  </Grid>
</UserControl>

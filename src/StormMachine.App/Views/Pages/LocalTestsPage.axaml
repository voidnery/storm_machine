<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StormMachine.App.ViewModels"
             xmlns:views="using:StormMachine.App.Views"
             xmlns:forms="using:StormMachine.App.Controls"
             x:Class="StormMachine.App.Views.Pages.LocalTestsPage"
             x:DataType="vm:LocalTestsPageViewModel">

  <Grid RowDefinitions="Auto,*" Margin="24,20">

    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
      <forms:MethodCard Thesis="{x:Static vm:LocalTestsPageViewModel.Note}"
                        Detail="{x:Static vm:LocalTestsPageViewModel.NoteWhy}" Margin="0,4,0,0" />
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <views:ProbeRunnerView DataContext="{Binding Runner}" Margin="0,0,10,20" />
    </ScrollViewer>
  </Grid>
</UserControl>

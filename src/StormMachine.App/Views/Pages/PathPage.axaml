<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StormMachine.App.ViewModels"
             xmlns:controls="using:StormMachine.App.Controls"
             xmlns:results="using:StormMachine.Domain.Results"
             x:Class="StormMachine.App.Views.Pages.PathPage"
             x:DataType="vm:PathPageViewModel">

  <UserControl.Styles>
    <!-- Состояние хопа задаётся классами, а не кистями из модели:
         внешний вид остаётся в разметке, где ему и место. -->
    <Style Selector="Border.hop">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.hop.silent">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Border.hop.destination">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Background" Value="{StaticResource InsetBrush}" />
    </Style>
    <Style Selector="Border.hop.degraded">
      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
      <Setter Property="Background" Value="{StaticResource DangerSurfaceBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="24,20">

    <!-- Заголовок с условиями измерения бейджами -->
    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock Text="{Binding Title}" Classes="h1" />
      <ItemsControl ItemsSource="{Binding Conditions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ConditionRow">
            <controls:ConditionBadge Label="{Binding Label}" Value="{Binding Value}" Margin="0,0,6,4" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Предупреждение об окружении -->
    <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,8" CornerRadius="4"
            Background="{StaticResource WarningSurfaceBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
            IsVisible="{Binding TimingWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding TimingWarning}" TextWrapping="Wrap" FontSize="12"
                 Foreground="{StaticResource WarningBrush}" />
    </Border>

    <!-- Панель запуска -->
    <Border Grid.Row="2" Margin="0,12,0,0" Padding="14" CornerRadius="6"
            Background="{StaticResource PanelBrush}">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="2*,Auto,Auto,Auto,Auto,Auto">
          <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0" MinWidth="320">
            <TextBlock Text="Цель" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <!-- Подсказки из инвентаря (И-24): Popup под самим полем, шириной с него. -->
            <Grid ColumnDefinitions="*,Auto">
              <AutoCompleteBox x:Name="TargetBox" Grid.Column="0" Text="{Binding TargetText}"
                               ItemsSource="{Binding Suggestions}"
                               ItemFilter="{x:Static vm:TargetSuggestions.Filter}"
                               MinimumPrefixLength="1" PlaceholderText="1.1.1.1, example.com или gateway"
                               IsEnabled="{Binding CanStart}">
                <AutoCompleteBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TargetSuggestion">
                    <TextBlock Text="{Binding Description}" FontSize="12" />
                  </DataTemplate>
                </AutoCompleteBox.ItemTemplate>
              </AutoCompleteBox>
              <Button Grid.Column="1" Content="▾" FontSize="11" Padding="8,6" Margin="4,0,0,0"
                      Command="{Binding OpenPickerCommand}"
                      IsEnabled="{Binding CanStart}" ToolTip.Tip="Подставить цель из инвентаря" />
              <Popup PlacementTarget="{Binding #TargetBox}" Placement="BottomEdgeAlignedLeft"
                     IsOpen="{Binding IsPickerOpen, Mode=TwoWay}" IsLightDismissEnabled="True">
                <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="4"
                        Padding="4" MinWidth="{Binding #TargetBox.Bounds.Width}" MaxWidth="480"
                        MaxHeight="300">
                  <ScrollViewer>
                    <StackPanel>
                      <TextBlock Text="Инвентарь пуст — просканируйте сеть в «Обнаружении»."
                                 FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="8,6"
                                 IsVisible="{Binding !Suggestions.Count}" />
                      <ItemsControl ItemsSource="{Binding Suggestions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TargetSuggestion">
                            <Button Content="{Binding Description}" FontSize="12" Padding="8,4"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    Command="{Binding $parent[ItemsControl].((vm:PathPageViewModel)DataContext).UseSuggestionCommand}"
                                    CommandParameter="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </StackPanel>

          <!-- Ширина 140: у NumericUpDown стрелки съедают место, и «100» в 110 px
               обрезалось (замечание оператора, И-24). -->
          <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,12,0" Width="140">
            <TextBlock Text="Предел хопов" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <NumericUpDown Value="{Binding MaxHops}" Minimum="1" Maximum="255" Increment="1"
                           FormatString="0" IsEnabled="{Binding CanStart}" />
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="4" Margin="0,0,12,0" Width="140">
            <TextBlock Text="Циклов" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <NumericUpDown Value="{Binding Rounds}" Minimum="1" Maximum="100000" Increment="10"
                           FormatString="0" IsEnabled="{Binding !Continuous}" />
          </StackPanel>

          <StackPanel Grid.Column="3" Spacing="4" Margin="0,0,12,0" Width="140">
            <TextBlock Text="Интервал, мс" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <NumericUpDown Value="{Binding IntervalMs}" Minimum="100" Maximum="600000" Increment="100"
                           FormatString="0" IsEnabled="{Binding CanStart}" />
          </StackPanel>

          <StackPanel Grid.Column="4" Spacing="8" Margin="0,0,14,0" VerticalAlignment="Bottom">
            <CheckBox IsChecked="{Binding Continuous}" Content="Непрерывно" FontSize="12"
                      IsEnabled="{Binding CanStart}" />
            <CheckBox IsChecked="{Binding SaveToJournal}" Content="Писать в журнал" FontSize="12"
                      IsEnabled="{Binding CanStart}" />
          </StackPanel>

          <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
            <Button Content="Запустить" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"
                    Padding="18,7" Background="{StaticResource AccentBrush}" Foreground="White" />
            <Button Content="Остановить" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"
                    Padding="14,7" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="Auto,220,Auto,*">
          <TextBlock Grid.Column="0" Text="Сохранить как пресет:" Classes="body"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBox Grid.Column="1" Text="{Binding PresetName}" PlaceholderText="имя пресета" FontSize="12" />
          <Button Grid.Column="2" Content="Сохранить" Command="{Binding SaveAsPresetCommand}"
                  FontSize="12" Padding="12,5" Margin="8,0,0,0" />
        </Grid>

        <!-- Статусу — постоянное место под панелью запуска -->
        <controls:StatusLine Text="{Binding StatusLine}" State="{Binding StatusState}" />

        <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Border>

    <!-- Итог: то, ради чего трассировку и открывают -->
    <Border Grid.Row="3" Margin="0,12,0,0" Padding="14,10" CornerRadius="6"
            Background="{StaticResource PanelBrush}">
      <!-- Четыре разножанровые строки развели по формам: вердикт со знаком уровня,
           деградация — оговоркой, объяснение непостоянной длины пути — карточкой
           «почему так». Раньше всё это шло одинаковым серым столбиком. -->
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,16,0">
          <controls:VerdictLine Text="{Binding Verdict}" Level="{Binding VerdictLevel}" />
          <controls:Caveat Text="{Binding Degradation}" />
          <controls:MethodCard Thesis="{Binding PathLengthNote}"
                               IsVisible="{Binding PathLengthNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="{Binding RouteChanges}" Classes="label" TextWrapping="Wrap"
                     IsVisible="{Binding RouteChanges, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="{Binding AsnHint}" Classes="caption" TextWrapping="Wrap"
                     IsVisible="{Binding AsnHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <controls:CopyChip Text="{Binding AsnFolder}"
                             IsVisible="{Binding AsnFolder, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <controls:StatTile Grid.Column="1" Width="90" Caption="Хопов" Value="{Binding HopCount}" />
        <controls:StatTile Grid.Column="2" Width="90" Caption="Молчащих" Value="{Binding SilentHops}" />
      </Grid>
    </Border>

    <!-- Маршрут и история -->
    <Grid Grid.Row="4" ColumnDefinitions="*,300" Margin="0,14,0,0">

      <Border Grid.Column="0" CornerRadius="6" Background="{StaticResource SurfaceBrush}" Padding="10">
        <Grid RowDefinitions="Auto,*,Auto">

          <Grid Grid.Row="0" ColumnDefinitions="40,*,92,110,80,80,80,80,50" Margin="4,0,4,6">
            <TextBlock Grid.Column="0" Text="хоп" Classes="label" ToolTip.Tip="Номер узла на пути пакета" />
            <TextBlock Grid.Column="1" Text="узел" Classes="label" />
            <TextBlock Grid.Column="2" Text="отправлено" Classes="label" />
            <TextBlock Grid.Column="3" Text="потери" Classes="label" />
            <TextBlock Grid.Column="4" Text="мин" Classes="label" />
            <TextBlock Grid.Column="5" Text="медиана" Classes="label" />
            <TextBlock Grid.Column="6" Text="макс" Classes="label" />
            <TextBlock Grid.Column="7" Text="джиттер" Classes="label"
                       ToolTip.Tip="Дрожание задержки по RFC 3550: насколько неровно приходят ответы" />
            <TextBlock Grid.Column="8" Text="MOS" Classes="label"
                       ToolTip.Tip="Оценка разговорной связи по шкале от 1 до 5" />
          </Grid>

          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Hops}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HopRowViewModel">
                  <Border Classes="hop"
                          Classes.silent="{Binding IsSilent}"
                          Classes.destination="{Binding IsDestination}"
                          Classes.degraded="{Binding IsDegradationPoint}"
                          Padding="6,3" CornerRadius="3" Margin="0,1">
                    <StackPanel Spacing="1">
                      <Grid ColumnDefinitions="40,*,92,110,80,80,80,80,50">
                        <TextBlock Grid.Column="0" Text="{Binding Hop}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Address}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Sent}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />

                        <Grid Grid.Column="3" ColumnDefinitions="44,*" Margin="0,0,10,0">
                          <TextBlock Grid.Column="0" Text="{Binding Loss}" FontSize="12" />
                          <!-- MinWidth="0" обязателен: у ProgressBar в теме Fluent он ~200,
                               и полоса требовала больше своей ячейки — ложилась поверх
                               соседних колонок (замечание оператора, И-24). -->
                          <ProgressBar Grid.Column="1" Minimum="0" Maximum="100"
                                       Value="{Binding LossPercent}" Height="4" MinWidth="0"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Grid.Column="4" Text="{Binding Min}" FontSize="12" />
                        <TextBlock Grid.Column="5" Text="{Binding Median}" FontSize="12" />
                        <TextBlock Grid.Column="6" Text="{Binding Max}" FontSize="12" />
                        <TextBlock Grid.Column="7" Text="{Binding Jitter}" FontSize="12" />
                        <TextBlock Grid.Column="8" Text="{Binding Mos}" FontSize="12" />
                      </Grid>

                      <TextBlock Text="{Binding ShortPathNote}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="40,0,0,0"
                                 IsVisible="{Binding ShortPathNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <TextBlock Text="{Binding Annotation}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="40,0,0,0"
                                 TextTrimming="CharacterEllipsis"
                                 IsVisible="{Binding Annotation, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <TextBlock Text="{Binding AlternateAddresses}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="40,0,0,0"
                                 TextTrimming="CharacterEllipsis"
                                 IsVisible="{Binding AlternateAddresses, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Spacing="6" Margin="4,8,4,0">
            <!-- Единица названа один раз для всей таблицы: у сорока чисел
                 «мс» у каждого превратило бы её в частокол. -->
            <TextBlock Text="Времена в миллисекундах. MOS — оценка речи по шкале от 1 до 5."
                       Classes="caption" />

            <!-- Главная методическая оговорка экрана: ради неё разбор и строился.
                 До волны 2 она стояла здесь же, но самым мелким кеглем. -->
            <controls:MethodCard Thesis="MOS на транзитных хопах считается по задержке и дрожанию, без потерь."
                                 Detail="MOS — оценка разговорной связи по шкале от 1 до 5, вместе с R-фактором она считается по упрощённой E-модели ITU-T G.107. Потери на транзитном узле — это ограничение его собственных ответов, а не потеря проходящего трафика." />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" Margin="14,0,0,0" CornerRadius="6"
              Background="{StaticResource PanelBrush}" Padding="12">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,8">
            <TextBlock Text="История трассировок" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="Сохранённые прогоны trace. Выбери — покажу маршрут."
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
          </StackPanel>

          <ListBox Grid.Row="1" Name="HistoryList" ItemsSource="{Binding History}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="results:RunSummary">
                <StackPanel Spacing="1" Margin="0,3">
                  <TextBlock Text="{Binding TargetDisplay}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0:dd.MM HH:mm:ss} · {1} проб · {2:0.0}% потерь">
                        <Binding Path="StartedUtc.LocalDateTime" />
                        <Binding Path="SentCount" />
                        <Binding Path="LossPercent" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="6,2" />
              </Style>
            </ListBox.Styles>
          </ListBox>

          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Обновить" Command="{Binding RefreshHistoryCommand}" FontSize="12" Padding="10,4" />
            <Button Content="Показать" FontSize="12" Padding="10,4"
                    Command="{Binding LoadRunCommand}"
                    CommandParameter="{Binding #HistoryList.SelectedItem}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

  </Grid>
</UserControl>

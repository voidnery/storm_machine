<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StormMachine.App.ViewModels"
             xmlns:presets="using:StormMachine.Domain.Presets"
             x:Class="StormMachine.App.Views.Pages.PresetsPage"
             x:DataType="vm:PresetsPageViewModel">

  <Grid RowDefinitions="Auto,*" Margin="24,20">

    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
        <Button Grid.Column="1" Content="Импорт" Command="{Binding ImportCommand}" Padding="12,5" Margin="0,0,8,0" />
        <Button Grid.Column="2" Content="Экспорт" Command="{Binding ExportCommand}" Padding="12,5" />
      </Grid>
      <TextBlock Text="{Binding Description}" FontSize="13" Opacity="0.7" TextWrapping="Wrap" />

      <TextBlock Text="{Binding Message}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                 IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="380,*">

      <!-- Список -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="10">
        <Grid RowDefinitions="Auto,*">
          <TextBox Grid.Row="0" Text="{Binding Search}" PlaceholderText="поиск по имени и описанию"
                   Margin="0,0,0,8" FontSize="12" />

          <ListBox Grid.Row="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding Selected}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="presets:Preset">
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Background="#2E3648" CornerRadius="3" Padding="5,1">
                        <TextBlock Text="{Binding ProbeName}" FontSize="10" />
                      </Border>
                      <TextBlock Text="{Binding Target.DisplayName}" FontSize="10" Opacity="0.5"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Version, StringFormat='ред. {0}'}" FontSize="10" Opacity="0.5" />
                    <TextBlock Text="{Binding RunCount, StringFormat='{}{0} зап.'}" FontSize="10" Opacity="0.5" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Подробности -->
      <Border Grid.Column="1" Margin="14,0,0,0" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="16">
        <Grid RowDefinitions="Auto,Auto,*,Auto">

          <TextBlock Grid.Row="0" Text="{Binding Details}" FontSize="13" TextWrapping="Wrap" LineHeight="20" />

          <Border Grid.Row="1" Margin="0,12,0,0" Padding="10,7" CornerRadius="4" Background="#3A2E12"
                  IsVisible="{Binding ValidationWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding ValidationWarning}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource WarningBrush}" />
          </Border>

          <StackPanel Grid.Row="2" Spacing="4" Margin="0,14,0,0">
            <TextBlock Text="Параметры" FontWeight="SemiBold" FontSize="12" Opacity="0.7" />
            <ItemsControl ItemsSource="{Binding Parameters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ParameterRow">
                  <Grid ColumnDefinitions="180,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" Opacity="0.65" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
            <Button Content="Запустить" Command="{Binding RunCommand}"
                    Padding="18,7" Background="{StaticResource AccentBrush}" Foreground="White" />
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Padding="14,7" />
            <Button Content="Обновить" Command="{Binding RefreshCommand}" Padding="14,7" />
          </StackPanel>

        </Grid>
      </Border>
    </Grid>

  </Grid>
</UserControl>

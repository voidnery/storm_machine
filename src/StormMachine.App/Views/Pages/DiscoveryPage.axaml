<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StormMachine.App.ViewModels"
             x:Class="StormMachine.App.Views.Pages.DiscoveryPage"
             x:DataType="vm:DiscoveryPageViewModel">

  <UserControl.Styles>
    <Style Selector="Border.device">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.device.gateway">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Background" Value="#16202C" />
    </Style>
    <Style Selector="Border.device.offline">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24,20">

    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
      <TextBlock FontSize="12" Opacity="0.6">
        <TextBlock.Text>
          <MultiBinding StringFormat="{}{0} · {1}">
            <Binding Path="InterfaceInfo" />
            <Binding Path="CatalogInfo" />
          </MultiBinding>
        </TextBlock.Text>
      </TextBlock>
    </StackPanel>

    <!-- Панель запуска. Объём показывается до запуска, а не после: сканирование —
         активное действие по чужой сети. -->
    <Border Grid.Row="1" Margin="0,12,0,0" Padding="14" CornerRadius="6"
            Background="{StaticResource PanelBrush}">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="2*,Auto,Auto,Auto,Auto">
          <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0">
            <TextBlock Text="Диапазон" FontSize="11" Opacity="0.6" />
            <TextBox Text="{Binding RangeText}" PlaceholderText="192.168.1.0/24 или 192.168.1.10-192.168.1.40"
                     IsEnabled="{Binding CanStart}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,12,0" Width="110">
            <TextBlock Text="Одновременно" FontSize="11" Opacity="0.6" />
            <NumericUpDown Value="{Binding Parallelism}" Minimum="1" Maximum="512" Increment="16"
                           FormatString="0" IsEnabled="{Binding CanStart}" />
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="4" Margin="0,0,12,0" Width="110">
            <TextBlock Text="Таймаут, мс" FontSize="11" Opacity="0.6" />
            <NumericUpDown Value="{Binding TimeoutMs}" Minimum="50" Maximum="10000" Increment="100"
                           FormatString="0" IsEnabled="{Binding CanStart}" />
          </StackPanel>

          <StackPanel Grid.Column="3" Spacing="8" Margin="0,0,14,0" VerticalAlignment="Bottom">
            <CheckBox IsChecked="{Binding ProbeCommonPorts}" Content="Проверять частые порты" FontSize="12"
                      IsEnabled="{Binding CanStart}"
                      ToolTip.Tip="Узлы с брандмауэром не отвечают на ICMP, но принимают соединения." />
            <CheckBox IsChecked="{Binding ResolveNames}" Content="Узнавать имена" FontSize="12"
                      IsEnabled="{Binding CanStart}" />
          </StackPanel>

          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
            <Button Content="Моя сеть" Command="{Binding UseOwnSubnetCommand}" Padding="12,7"
                    IsEnabled="{Binding CanStart}" />
            <Button Content="Сканировать" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"
                    Padding="18,7" Background="{StaticResource AccentBrush}" Foreground="White" />
            <Button Content="Остановить" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"
                    Padding="14,7" />
          </StackPanel>
        </Grid>

        <TextBlock Text="{Binding RangeSummary}" FontSize="12" Opacity="0.65" />

        <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Border>

    <!-- Ход и итог -->
    <Border Grid.Row="2" Margin="0,12,0,0" Padding="14,10" CornerRadius="6"
            Background="{StaticResource PanelBrush}">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding StatusLine}" FontSize="13" TextWrapping="Wrap" />
          <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="12" Opacity="0.6"
                     VerticalAlignment="Center" />
        </Grid>

        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="4" />

        <TextBlock Text="{Binding Conclusion}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                   IsVisible="{Binding Conclusion, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Border>

    <!-- Найденное -->
    <Border Grid.Row="3" Margin="0,14,0,0" CornerRadius="6" Background="#151922" Padding="10">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="150,170,*,220,180" Margin="8,0,4,6">
          <TextBlock Grid.Column="0" Text="адрес" FontSize="11" Opacity="0.5" />
          <TextBlock Grid.Column="1" Text="MAC" FontSize="11" Opacity="0.5" />
          <TextBlock Grid.Column="2" Text="имя" FontSize="11" Opacity="0.5" />
          <TextBlock Grid.Column="3" Text="вендор" FontSize="11" Opacity="0.5" />
          <TextBlock Grid.Column="4" Text="что ответило" FontSize="11" Opacity="0.5" />
        </Grid>

        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Devices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DeviceRow">
                <Border Classes="device"
                        Classes.gateway="{Binding IsGateway}"
                        Classes.offline="{Binding !IsOnline}"
                        Padding="6,3" CornerRadius="3" Margin="0,1">
                  <Grid ColumnDefinitions="150,170,*,220,180">
                    <TextBlock Grid.Column="0" Text="{Binding Address}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding MacAddress}" FontSize="12" Opacity="0.8" />
                    <TextBlock Grid.Column="2" Text="{Binding HostName}" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding Vendor}" FontSize="12" Opacity="0.8"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4" Text="{Binding Found}" FontSize="11" Opacity="0.6"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StormMachine.App.ViewModels"
             xmlns:forms="using:StormMachine.App.Controls"
             xmlns:results="using:StormMachine.Domain.Results"
             x:Class="StormMachine.App.Views.Pages.RunsPage"
             x:DataType="vm:RunsPageViewModel">

  <Grid RowDefinitions="Auto,*,Auto" Margin="24,20">

    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
        <Button Grid.Column="1" Content="Отчёт PDF" Command="{Binding SaveReportCommand}" IsEnabled="{Binding HasSelection}"
                Padding="14,5" Margin="0,0,8,0"
                Background="{StaticResource AccentBrush}" Foreground="White" />

        <!-- Выгрузка отдельно от отчёта: отчёт объясняет, выгрузка отдаёт -->
        <Button Grid.Column="2" Content="Выгрузить" Padding="12,5" Margin="0,0,8,0" IsEnabled="{Binding HasSelection}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="CSV — таблица" Command="{Binding ExportCommand}" CommandParameter="csv" />
              <MenuItem Header="JSON — для чужой программы" Command="{Binding ExportCommand}" CommandParameter="json" />
              <MenuItem Header="PNG — график" Command="{Binding ExportCommand}" CommandParameter="png" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <Button Grid.Column="3" Content="В эталон" Command="{Binding CaptureBaselineCommand}" IsEnabled="{Binding HasSelection}"
                Padding="12,5" Margin="0,0,8,0"
                ToolTip.Tip="Зафиксировать это измерение нормой вместе с условиями, в которых оно сделано" />

        <Button Grid.Column="4" Content="Обновить" Command="{Binding RefreshCommand}" Padding="12,5" Margin="0,0,8,0" />
        <Button Grid.Column="5" Content="Удалить" Command="{Binding DeleteSelectedCommand}" Padding="12,5" IsEnabled="{Binding HasSelection}" />
      </Grid>
      <!-- Сводка плитками, путь — копируемым чипом: раньше четыре числа и путь шли
           одной серой строкой, и путь в ней обрезался. -->
      <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,6,0,2">
        <forms:StatTile Grid.Column="0" Width="110" Caption="Прогонов" Value="{Binding RunCountText}" />
        <forms:StatTile Grid.Column="1" Width="130" Caption="Сырых измерений" Value="{Binding SampleCountText}" />
        <forms:StatTile Grid.Column="2" Width="130" Caption="Размер файла" Value="{Binding SizeText}" />
        <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="Файл журнала" Classes="caption" />
          <forms:CopyChip Text="{Binding StorePath}" />
        </StackPanel>
      </Grid>

      <forms:Caveat Text="{Binding FreeSpaceNotice}" />
      <forms:Caveat Text="{Binding UsageError}" />

      <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="420,*">

      <!-- Список прогонов -->
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="8">
        <Panel>
        <!-- Пустой список молчал: экран без данных обязан говорить, что сделать. -->
        <TextBlock Text="Журнал пуст. Запустите измерение — прогоны сохраняются сюда сами, если у пробы отмечено «В журнал»."
                   Classes="label" TextWrapping="Wrap" Margin="8" VerticalAlignment="Top"
                   IsVisible="{Binding !Runs.Count}" />

        <ListBox ItemsSource="{Binding Runs}"
                 SelectedItem="{Binding SelectedRun}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="results:RunSummary">
              <Grid ColumnDefinitions="56,*,Auto" Margin="0,3">
                <Border Grid.Column="0" Background="{StaticResource DividerBrush}" CornerRadius="3" Padding="5,1"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ProbeName}" FontSize="10" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="1" Margin="8,0">
                  <TextBlock Text="{Binding TargetDisplay}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding StartedUtc.LocalDateTime, StringFormat='{}{0:dd.MM HH:mm:ss}'}"
                             FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding SentCount, StringFormat='{}{0} проб'}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Panel>
      </Border>

      <!-- Подробности -->
      <Border Grid.Column="1" Margin="14,0,0,0" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="16">
        <ScrollViewer>
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding Details}" FontSize="13" TextWrapping="Wrap" LineHeight="20" />

            <!-- Оговорка честности: сырья у этого прогона больше нет, и графика по нему
                 не будет. В ряду с остальными строками она терялась. -->
            <forms:Caveat Text="{Binding RetentionNotice}" />

            <!-- Ряды: фазы, резолверы, хопы или весь прогон — зависит от формы результата.
                 Таблица собрана из ItemsControl намеренно: DataGrid потянул бы отдельный
                 пакет с собственной темой ради семи колонок только для чтения. -->
            <!-- Заголовки и шапка таблицы прячутся вместе с содержимым: без выбора
                 справа висели «Ряды», «Факты» и пустая строка колонок. -->
            <StackPanel Spacing="4" IsVisible="{Binding HasSelection}">
              <TextBlock Text="Ряды" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />

              <Grid ColumnDefinitions="*,60,70,90,90,90,90" Margin="0,2">
                <TextBlock Grid.Column="0" Text="ряд" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="1" Text="проб" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="2" Text="потери" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="3" Text="мин" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="4" Text="медиана" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="5" Text="макс" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="6" Text="джиттер" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
              </Grid>

              <ItemsControl ItemsSource="{Binding Series}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SeriesRow">
                    <Grid ColumnDefinitions="*,60,70,90,90,90,90" Margin="0,2">
                      <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Sent}" FontSize="12" />
                      <TextBlock Grid.Column="2" Text="{Binding Loss}" FontSize="12" />
                      <TextBlock Grid.Column="3" Text="{Binding Min}" FontSize="12" />
                      <TextBlock Grid.Column="4" Text="{Binding Median}" FontSize="12" />
                      <TextBlock Grid.Column="5" Text="{Binding Max}" FontSize="12" />
                      <TextBlock Grid.Column="6" Text="{Binding Jitter}" FontSize="12" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding SeriesUnit}" Classes="caption" />
            </StackPanel>

            <!-- Факты: то, что не является числом во временном ряду -->
            <StackPanel Spacing="6" IsVisible="{Binding HasSelection}">
              <TextBlock Text="Факты" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
              <ItemsControl ItemsSource="{Binding Facts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FactRow">
                    <Grid ColumnDefinitions="70,200,*" Margin="0,2">
                      <TextBlock Grid.Column="0" Text="{Binding Category}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" />
                      <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap"
                                 Foreground="{StaticResource WarningBrush}"
                                 IsVisible="{Binding IsWarning}" />
                      <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap"
                                 IsVisible="{Binding !IsWarning}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

  </Grid>
</UserControl>

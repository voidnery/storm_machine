<Project Sdk="Microsoft.NET.Sdk">

  <!-- Корень композиции.
       Единственное место, которому разрешено знать обо всех слоях сразу. Существует,
       чтобы клиенты (CLI, GUI, в будущем — сервер) собирали продукт одинаково
       и при этом сами не ссылались на инфраструктуру. -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Description>Сборка продукта из слоёв: единая точка регистрации зависимостей.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StormMachine.Application\StormMachine.Application.csproj" />
    <ProjectReference Include="..\StormMachine.Agents\StormMachine.Agents.csproj" />
    <ProjectReference Include="..\StormMachine.Alerting\StormMachine.Alerting.csproj" />
    <ProjectReference Include="..\StormMachine.Platform\StormMachine.Platform.csproj" />
    <ProjectReference Include="..\StormMachine.Discovery\StormMachine.Discovery.csproj" />
    <ProjectReference Include="..\StormMachine.Probes\StormMachine.Probes.csproj" />
    <ProjectReference Include="..\StormMachine.Reporting\StormMachine.Reporting.csproj" />
    <ProjectReference Include="..\StormMachine.Snmp\StormMachine.Snmp.csproj" />
    <ProjectReference Include="..\StormMachine.Storage\StormMachine.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>

</Project>

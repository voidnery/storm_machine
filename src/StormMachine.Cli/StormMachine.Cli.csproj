<Project Sdk="Microsoft.NET.Sdk">

  <!-- Консольный клиент ядра.
       Существует не только ради удобства: если CLI работает, значит слой приложения
       действительно не зависит от интерфейса. Это доказательство принципа 2
       (docs/01-analysis.md §8.2) по построению, а не по декларации. -->

  <PropertyGroup>
    <ApplicationIcon>..\StormMachine.App\Assets\storm.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>storm</AssemblyName>
    <RootNamespace>StormMachine.Cli</RootNamespace>
    <Description>Storm Machine — консольный клиент.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>

    <!-- Клиент несёт ядро продукта целиком, а с ним движок раскладки графа.
         Что из этого следует для обрезки — в Directory.Build.targets. -->
    <HostsProductCore>true</HostsProductCore>

    <!-- Нативные библиотеки — внутрь бинаря, а не россыпью рядом с ним.
         Без этой строки PublishSingleFile складывает рядом с storm.exe пять чужих
         DLL: SQLite, Skia, HarfBuzz, qpdf. Файл называется «одним», а работает
         только вместе с папкой — и первый же, кто унесёт из неё один storm.exe,
         получит падение на первом обращении к базе.
         Поймано приёмкой И-17: девять шагов из девяти легли с DllNotFoundException,
         потому что нативные библиотеки из папки публикации пропали, а storm.exe
         остался. У графического клиента эта строка стояла с И-0 — здесь её забыли. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Только слой приложения и корень композиции. Ссылок на инфраструктуру нет
       и быть не должно — это проверяется архитектурным тестом. -->
  <ItemGroup>
    <ProjectReference Include="..\StormMachine.Application\StormMachine.Application.csproj" />
    <ProjectReference Include="..\StormMachine.Composition\StormMachine.Composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
  </ItemGroup>

</Project>

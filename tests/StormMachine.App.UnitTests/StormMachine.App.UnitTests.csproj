<Project Sdk="Microsoft.NET.Sdk">

  <!-- Проверки графического клиента.

       Два предмета. ViewModel — обычные классы без ссылки на графику, их проверяют
       обычные тесты. И сами страницы: с И-24 они открываются в headless-платформе
       Avalonia — рендер без экрана, — и по живому визуальному дереву проверяется то,
       что раньше видел только глаз оператора: тексты без дыр, кнопки с командами.
       Компилятор разметки ловит опечатки в привязках, но не то, как текст выглядит. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StormMachine.App\StormMachine.App.csproj" />
    <ProjectReference Include="..\..\src\StormMachine.Composition\StormMachine.Composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Headless-платформа без адаптера Avalonia.Headless.XUnit: адаптер 12.x живёт
         на xunit v3, а v3 требует исполняемый тестовый проект — которому нельзя
         ссылаться на self-contained клиента. Сессия заводится руками, это десяток
         строк против смены тестовой инфраструктуры всего решения. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

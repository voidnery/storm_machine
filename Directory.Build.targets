<Project>

  <!-- ДВИЖОК РАСКЛАДКИ ГРАФА И ОБРЕЗКА.

       MSAGL внутри пользуется рефлексией. Обрезчик этого не понимает и предупреждает
       о сборке целиком (IL2104). Предупреждение правдиво, и потому сборка вносится
       в корни обрезки целиком: внутри неё ничего не выкидывается, и предупреждение
       перестаёт описывать наш случай. Измерено при И-0: 54.5 МБ без этой строки против
       56.7 МБ с ней — 2.2 МБ за то, чтобы карта сети не отвалилась молча у пользователя.

       Правило живёт здесь, а не в csproj клиентов, начиная с И-15. Тогда раскладка
       переехала из графического клиента в обнаружение — она понадобилась двоим: полотну
       на экране и схеме в отчёте. Публикующих проектов стало два, и настройка, записанная
       в одном из них, немедленно сломала публикацию второго. Третий забыл бы её так же.

       Включается свойством HostsProductCore, которое клиент объявляет у себя. Вывести
       его из ссылок автоматически MSBuild не даёт: списки элементов в условиях за
       пределами целей запрещены. Зато забывчивость обходится дёшево — новый клиент,
       не объявивший свойство, немедленно не публикуется с IL2104, а не ломается молча
       у пользователя. Агент свойства не объявляет: он на корень композиции не ссылается,
       раскладку не тянет, и вносить в корни отсутствующую сборку было бы ошибкой. -->

  <ItemGroup Condition="'$(PublishTrimmed)' == 'true' AND '$(HostsProductCore)' == 'true'">
    <TrimmerRootAssembly Include="AutomaticGraphLayout" />
  </ItemGroup>

  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true' AND '$(HostsProductCore)' == 'true'">
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

</Project>

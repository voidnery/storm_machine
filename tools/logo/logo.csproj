<Project Sdk="Microsoft.NET.Sdk">

  <!-- Генератор фирменного знака.
       В решение НЕ входит намеренно: запускается руками, когда знак меняется,
       а его результат — файлы в assets/ — лежит в репозитории. Собирать его
       в CI незачем, а держать знак только в виде картинки значило бы потерять
       способ его пересоздать. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>logo</AssemblyName>
    <RootNamespace>StormMachine.Tools.Logo</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>none</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.0" />
  </ItemGroup>

</Project>

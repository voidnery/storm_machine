<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>spike04</AssemblyName>
    <RootNamespace>Spike04</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1852;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Тот самый движок раскладки, который AvaloniaGraphControl несёт внутри себя. -->
    <PackageReference Include="AutomaticGraphLayout" Version="1.1.12" />
  </ItemGroup>
</Project>

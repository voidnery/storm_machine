<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>spike10</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1303;CA1861;CA1031</NoWarn>
  </PropertyGroup>

  <!-- Разбор берётся у продукта, а не пишется заново: половина вопроса спайка —
       поймёт ли НАШ разборщик кадры, пришедшие не от Npcap. -->
  <ItemGroup>
    <ProjectReference Include="..\..\plugins\StormMachine.Capture.Npcap\StormMachine.Capture.Npcap.csproj" />
  </ItemGroup>
</Project>

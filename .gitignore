# ---- Секреты (страховка: сюда ничего не должно попадать) ----
*.pfx

# Состояние агента: личность и список сопряжённых. Пишется рядом с исполняемым
# файлом — в этом портативность агента, — и в репозиторий попасть не должно
# ни при каких обстоятельствах: в .pfx лежит закрытый ключ.
storm-agent.identity.pfx
storm-agent.peers.json
storm-agent.peers.json.broken

# Готовые к раздаче артефакты: собираются tools/pack-agent, не хранятся.
/artifacts/
*.snk
*.pem
*.key
allowed_signers.local

# ---- ОС ----
Thumbs.db
desktop.ini
.DS_Store

# ---- НЕ игнорируем ----
!.githooks/
!.github/

# ---- Генератор знака ----
# Исходники генератора и готовый знак в репозитории; его сборка — нет.
tools/logo/bin/
tools/logo/obj/

# ---- Выходные файлы отчётов ----
# storm report кладёт PDF в текущий каталог. При запуске из каталога проекта
# они оказываются рядом с исходниками — в репозиторий им не надо.
/src/**/*.pdf
/src/**/*.csv
/src/**/*.png
!/src/StormMachine.App/Assets/**
